<Layouts.app
  flash={@flash}
  child_theme={if @profile, do: @profile.theme, else: "blue"}
  immersive={@live_action == :exam and flashcard_active?(@exam)}
>
  <main :if={@live_action == :exam and flashcard_active?(@exam)} id="flashcard-player">
    <.flashcard
      exam={@exam}
      answers={@answers}
      error={@error}
      close_path={child_path(@profile, ~p"/lecons/#{@lesson.id}")}
    />
  </main>
  <main
    :if={@live_action != :exam or not flashcard_active?(@exam)}
    class={["app", @live_action == :exam && "exam-app"]}
  >
    <div class="identity-row">
      <details
        :if={@profile}
        id="child-picker"
        phx-click-away={JS.remove_attribute("open", to: "#child-picker")}
        phx-window-keydown={JS.remove_attribute("open", to: "#child-picker")}
        phx-key="Escape"
      >
        <summary id="child-picker-toggle" aria-label="Compte et paramètres">
          <span class="child-picker-avatar">
            <img
              :if={@profile.avatar}
              id="profile-avatar"
              src={@profile.avatar}
              decoding="sync"
              alt=""
            />
            <span :if={!@profile.avatar} id="profile-initial">{String.first(@profile.name)}</span>
          </span>
          <span class="child-picker-name-row">
            <h1 id="child-name">{@profile.name}</h1>
            <.icon name="chevron-down" class="child-picker-chevron" />
          </span>
        </summary>
        <div id="child-picker-panel">
          <.form for={@form} action={~p"/profil"} method="post" id="profile-switch">
            <ul aria-label="Enfants">
              <li :for={p <- @profiles} :if={p.id != @profile.id}>
                <button
                  id={"switch-profile-#{p.id}"}
                  type="submit"
                  name="profile_id"
                  value={p.id}
                  class="child-picker-option"
                >
                  <span class="child-option-avatar" data-child-theme={p.theme}>
                    <img :if={p.avatar} src={p.avatar} alt="" />
                    <span :if={!p.avatar}>{String.first(p.name)}</span>
                  </span>
                  <span>{p.name}</span>
                  <.icon name="arrows-right-left" />
                </button>
              </li>
            </ul>
            <p :if={length(@profiles) == 1} id="no-other-profiles" class="muted">
              Aucun autre espace disponible.
            </p>
          </.form>
          <hr class="child-picker-separator" />
          <.link
            navigate={child_path(@profile, ~p"/parametres")}
            id="settings-link"
            class="child-picker-option"
            aria-current={if @live_action == :settings, do: "page"}
            phx-click={JS.remove_attribute("open", to: "#child-picker")}
          >
            <.icon name="hero-cog-6-tooth" />
            <span>Paramètres</span>
          </.link>
          <div class="child-picker-logout">
            <button id="logout" type="button" class="child-picker-option" disabled>
              <.icon name="hero-arrow-right-on-rectangle" />
              <span>Se déconnecter</span>
            </button>
          </div>
        </div>
      </details>
      <.link :if={!@profile} navigate={child_path(@profile, ~p"/parametres")} id="settings-link">
        Paramètres
      </.link>
    </div>
    <p :if={@error && !@modal} class="notice error" role="alert">{@error}</p>

    <section
      :if={!@profile && @live_action != :settings}
      id="no-profiles"
      class="onboarding panel"
    >
      <div class="icon-tile purple"><.icon name="book" /></div>
      <.page_title id="no-profiles-title">Aucun espace disponible</.page_title>
      <p>Les espaces de la famille n’ont pas encore été configurés.</p>
    </section>

    <section :if={@live_action == :settings} id="settings-page" class="setup-section">
      <div class="page-heading">
        <.page_breadcrumb
          id="settings-title"
          ancestors={[{"Matières", child_path(@profile, ~p"/")}]}
        >
          Paramètres
        </.page_breadcrumb>
      </div>
      <div id="theme-settings" class="theme-settings" phx-hook="ThemeSettings" phx-update="ignore">
        <section class="settings-card">
          <fieldset>
            <legend>Thème</legend>
            <div class="settings-choices">
              <label
                :for={
                  {value, label} <- [{"light", "Jour"}, {"dark", "Nuit"}, {"system", "Système"}]
                }
                for={"theme-#{value}"}
              >
                <input
                  id={"theme-#{value}"}
                  type="radio"
                  name="theme"
                  value={value}
                  checked={value == "system"}
                />
                <span>{label}</span>
              </label>
            </div>
          </fieldset>
        </section>
        <section class="settings-card">
          <fieldset>
            <legend>Niveau de zoom</legend>
            <div class="settings-choices">
              <label
                :for={
                  {value, label} <- [
                    {"small", "Plus petit"},
                    {"normal", "Normal"},
                    {"large", "Plus grand"}
                  ]
                }
                for={"zoom-#{value}"}
              >
                <input
                  id={"zoom-#{value}"}
                  type="radio"
                  name="zoom"
                  value={value}
                  checked={value == "normal"}
                />
                <span>{label}</span>
              </label>
            </div>
          </fieldset>
        </section>
        <p class="muted">Ces réglages sont conservés sur cet appareil.</p>
      </div>
      <.form
        :if={@profile}
        for={@subjects_form}
        id="subjects-settings-form"
        phx-submit="save_subjects"
        class="panel subjects-settings"
      >
        <fieldset aria-describedby="subjects-settings-help">
          <legend>Matières de {@profile.name}</legend>
          <p id="subjects-settings-help" class="muted">
            Choisis les matières à afficher. Les leçons et les contrôles des matières décochées sont conservés.
          </p>
          <input type="hidden" name="subjects[enabled_ids][]" value="" />
          <div class="subject-checkbox-grid">
            <label
              :for={subject <- Study.subjects()}
              for={"enable-subject-#{subject.id}"}
              class="subject-checkbox"
            >
              <input
                type="checkbox"
                id={"enable-subject-#{subject.id}"}
                name="subjects[enabled_ids][]"
                value={subject.id}
                checked={subject.id in @subjects_form[:enabled_ids].value}
              />
              <span>{subject.name}</span>
            </label>
          </div>
        </fieldset>
        <div class="form-actions">
          <button id="save-subjects" class="button primary" phx-disable-with="Enregistrement…">
            Enregistrer les matières
          </button>
        </div>
      </.form>
    </section>

    <div :if={@profile}>
      <section :if={@live_action == :home}>
        <div class="page-heading">
          <.page_breadcrumb id="subjects-title" ancestors={[]}>Mes matières</.page_breadcrumb>
        </div>
        <div :if={@subjects == []} id="no-enabled-subjects" class="empty-state">
          <p>Aucune matière activée.</p>
          <.link navigate={child_path(@profile, ~p"/parametres")} class="button secondary">
            Choisir les matières
          </.link>
        </div>
        <div class="subject-grid">
          <.link
            :for={s <- @subjects}
            navigate={child_path(@profile, ~p"/matieres/#{s.id}")}
            class={["subject-card", s.color]}
            id={"subject-#{s.id}"}
          >
            <div class="icon-tile"><.icon name={s.icon} /></div>
            <div class="subject-copy">
              <h2>{s.name}</h2>
              <span>
                {Map.get(@counts, s.id, 0)} {if Map.get(@counts, s.id, 0) == 1,
                  do: "leçon",
                  else: "leçons"}
              </span>
            </div>
            <.icon name="arrow" class="card-arrow" />
          </.link>
        </div>
      </section>

      <section :if={@live_action == :subject_settings}>
        <div class="page-heading">
          <.page_breadcrumb
            id="subject-settings-title"
            subject={@subject}
            ancestors={[
              {"Matières", child_path(@profile, ~p"/")},
              {@subject.name, child_path(@profile, ~p"/matieres/#{@subject.id}")}
            ]}
          >
            Paramètres
          </.page_breadcrumb>
        </div>
        <p class="muted subject-settings-intro">
          Types de questions disponibles en {@subject.name} pour {@profile.name}.
          Les modifications s’appliquent aux prochains contrôles.
        </p>
        <p :if={@available_question_types == []} id="no-question-types" class="muted">
          Aucun type de question. Ajoute un premier type ci-dessous.
        </p>
        <div id="configured-question-types" phx-update="stream">
          <article
            :for={{dom_id, type} <- @streams.subject_question_types}
            id={dom_id}
            class="configured-question-type"
          >
            <div class="question-type-copy">
              <h2>{type["label"]}</h2>
              <p>{type["description"]}</p>
            </div>
            <.form
              for={type["duration_form"]}
              id={"duration-form-#{type["id"]}"}
              class="question-duration-form"
              phx-change="update_question_duration"
              phx-submit="update_question_duration"
            >
              <label for={"type-duration-#{type["id"]}"}>Durée de travail</label>
              <div class="select-field">
                <select
                  id={"type-duration-#{type["id"]}"}
                  name={type["duration_form"][:work_duration].name}
                >
                  {Phoenix.HTML.Form.options_for_select(
                    CaptainHomework.WorkDuration.select_options(),
                    type["duration_form"][:work_duration].value
                  )}
                </select>
                <.icon name="chevron-down" class="select-chevron" />
              </div>
              <input type="hidden" name={type["duration_form"][:id].name} value={type["id"]} />
            </.form>
            <button
              id={"delete-type-#{type["id"]}"}
              type="button"
              class="button text-button"
              phx-click="delete_question_type"
              phx-value-id={type["id"]}
              data-confirm="Supprimer ce type pour cette matière et cet enfant ? Les contrôles existants sont conservés."
            >
              Supprimer
            </button>
          </article>
        </div>
        <.form
          for={@question_type_form}
          id="question-type-form"
          phx-submit="add_question_type"
          class="panel question-type-form"
        >
          <h2>Ajouter un type de question</h2>
          <label for="type-label">Nom</label>
          <input
            id="type-label"
            name={@question_type_form[:label].name}
            value={@question_type_form[:label].value}
            required
            maxlength="80"
            placeholder="Ex. : Calcul mental"
          />
          <label for="type-description">Consigne pour la génération</label>
          <textarea
            id="type-description"
            name={@question_type_form[:description].name}
            required
            maxlength="1000"
            rows="3"
            placeholder="Ex. : Proposer un calcul à effectuer de tête, avec une réponse numérique courte."
          >{@question_type_form[:description].value}</textarea>
          <label for="type-work-duration">Durée de travail</label>
          <div class="select-field">
            <select id="type-work-duration" name={@question_type_form[:work_duration].name}>
              {Phoenix.HTML.Form.options_for_select(
                CaptainHomework.WorkDuration.select_options(),
                @question_type_form[:work_duration].value
              )}
            </select>
            <.icon name="chevron-down" class="select-chevron" />
          </div>
          <p :for={{field, {message, _}} <- @question_type_form.errors} class="error">
            {question_type_field_label(field)} : {message}
          </p>
          <div class="form-actions">
            <button id="add-question-type" type="submit" class="button primary">
              <.icon name="plus" /> Ajouter
            </button>
          </div>
        </.form>
      </section>

      <section :if={@live_action == :subject}>
        <div class="page-heading">
          <.page_breadcrumb
            id="subject-title"
            subject={@subject}
            ancestors={[{"Matières", child_path(@profile, ~p"/")}]}
          >
            {@subject.name}
            <:trailing>
              <div class="subject-heading-actions">
                <button
                  class="button primary"
                  phx-click="open_modal"
                  phx-value-modal="lesson"
                  id="new-lesson"
                >
                  <.icon name="plus" /> Nouvelle leçon
                </button>
                <.link
                  id="subject-settings-link"
                  class="icon-button"
                  aria-label="Paramètres de la matière"
                  title="Paramètres de la matière"
                  navigate={child_path(@profile, ~p"/matieres/#{@subject.id}/parametres")}
                >
                  <.icon name="hero-cog-6-tooth" />
                </.link>
              </div>
            </:trailing>
          </.page_breadcrumb>
        </div>
        <div :if={@lessons_empty?} class="empty-state">
          <.icon name="book" />
          <p>Aucune leçon</p>
        </div>
        <div class="lesson-list" id="lessons" phx-update="stream">
          <.link
            :for={{dom_id, lesson} <- @streams.lessons}
            id={dom_id}
            navigate={child_path(@profile, ~p"/lecons/#{lesson.id}")}
            class="lesson-row"
          >
            <div class="document-icon"><.icon name="paper" /></div>
            <div class="row-copy">
              <h2>{lesson.title}</h2>
              <p>
                {date(lesson.date)}
                <span>·</span> {count_label(
                  Enum.count(lesson.pages, &(&1.kind == "lesson")),
                  "page",
                  "pages"
                )}
              </p>
            </div>
            <span class="muted lesson-exam-count">
              {count_label(
                Enum.count(lesson.exams, &(&1.status == "completed")),
                "contrôle",
                "contrôles"
              )}
            </span>
            <.icon name="arrow" />
          </.link>
        </div>
      </section>

      <section :if={@live_action == :lesson}>
        <div class="page-heading">
          <.page_breadcrumb
            id="lesson-title"
            subject={@subject}
            ancestors={[
              {"Matières", child_path(@profile, ~p"/")},
              {@subject.name, child_path(@profile, ~p"/matieres/#{@subject.id}")}
            ]}
          >
            {@lesson.title}
          </.page_breadcrumb>
        </div>
        <nav id="lesson-navigation" class="lesson-navigation" aria-label="Sections de la leçon">
          <.link
            :for={
              {tab, label, icon} <- [
                {"controles", "Contrôles", "paper"},
                {"cours", "Cours", "book"},
                {"ressources", "Ressources", "book"}
              ]
            }
            id={"lesson-tab-#{tab}"}
            patch={child_path(@profile, ~p"/lecons/#{@lesson.id}") <> "?onglet=#{tab}"}
            class="navigation-tab"
            aria-current={if @lesson_tab == tab, do: "page"}
          >
            <.icon name={icon} /> {label}
          </.link>
        </nav>
        <div :if={@lesson_tab == "controles"} id="lesson-controls">
          <div class="section-heading">
            <div>
              <h2>Les contrôles</h2>
              <span class="muted">
                {count_label(
                  Enum.count(@lesson.exams, &(&1.status == "completed")),
                  "terminé",
                  "terminés"
                )}
              </span>
            </div>
            <.link
              navigate={child_path(@profile, ~p"/lecons/#{@lesson.id}/controle")}
              class="button primary"
              id="new-exam"
            >
              <.icon name="plus" /> Nouveau contrôle
            </.link>
          </div>
          <div :if={@lesson.exams == []} class="empty-state compact">
            <p>Aucun contrôle</p>
          </div>
          <div class="exam-history">
            <.link
              :for={{exam, index} <- Enum.with_index(@lesson.exams)}
              navigate={child_path(@profile, ~p"/controles/#{exam.id}")}
              class="lesson-row"
            >
              <div class="document-icon"><.icon name="paper" /></div>
              <div class="row-copy">
                <div class="exam-history-title">
                  <h3>Contrôle {length(@lesson.exams) - index}</h3>
                  <span
                    id={"exam-format-#{exam.id}"}
                    class={["exam-format-badge", exam.format == "flashcard" && "flashcard-badge"]}
                  >
                    {if exam.format == "flashcard", do: "Flashcard", else: "Classique"}
                  </span>
                </div>
                <p>
                  {date(exam.submitted_at || exam.inserted_at)}
                  <span>·</span> {length(exam.questions)} questions
                </p>
              </div>
              <span
                :if={exam.status == "completed"}
                class={["score-badge", score_class(Exams.round_score(exam.score))]}
              >
                {number(Exams.round_score(exam.score))}<small>/20</small>
              </span>
              <span :if={exam.status != "completed"} class="status-badge">
                {case exam.status do
                  "grading" -> "Correction…"
                  "generating" -> "Préparation…"
                  "generation_partial" -> "À compléter"
                  _ -> "Reprendre"
                end}
              </span>
              <.icon name="arrow" />
            </.link>
          </div>
          <section id="lesson-examples">
            <div class="section-heading history-heading">
              <h2>Contrôles d’exemple</h2>
            </div>
            <div class="pages-grid">
              <article
                :for={
                  {page, index} <-
                    @lesson.pages |> Enum.filter(&(&1.kind == "example")) |> Enum.with_index(1)
                }
                id={"example-#{page.id}"}
                class="page-card"
              >
                <a
                  href={child_path(@profile, ~p"/pages/#{page.id}")}
                  target="_blank"
                  rel="noopener"
                  class="page-preview"
                >
                  <img src={child_path(@profile, ~p"/pages/#{page.id}")} alt={page.filename} />
                </a>
                <div class="page-order-actions">
                  <button
                    id={"example-previous-#{page.id}"}
                    type="button"
                    class="icon-button"
                    phx-click="move_page"
                    phx-value-id={page.id}
                    phx-value-direction="previous"
                    disabled={index == 1}
                    aria-label={"Déplacer la page d’exemple #{index} avant la précédente"}
                    title="Déplacer avant"
                  >
                    <.icon name="back" />
                  </button>
                  <button
                    id={"example-next-#{page.id}"}
                    type="button"
                    class="icon-button"
                    phx-click="move_page"
                    phx-value-id={page.id}
                    phx-value-direction="next"
                    disabled={index == Enum.count(@lesson.pages, &(&1.kind == "example"))}
                    aria-label={"Déplacer la page d’exemple #{index} après la suivante"}
                    title="Déplacer après"
                  >
                    <.icon name="arrow" />
                  </button>
                </div>
                <div class="page-caption">
                  <div>
                    <strong title={page.filename}>Page {index}</strong>
                    <.processing_progress
                      :if={page.processing_stage != nil}
                      id={"example-progress-#{page.id}"}
                      percent={page.processing_progress}
                      stage={page.processing_stage}
                    />
                    <span
                      :if={page.style_profile != nil and page.processing_stage == nil}
                      class="muted"
                    >
                      Prêt
                    </span>
                    <p :if={page.error != nil and page.processing_stage == nil} class="error">
                      {page.error}
                    </p>
                    <button
                      :if={page.error != nil and page.processing_stage == nil}
                      id={"retry-example-#{page.id}"}
                      type="button"
                      class="button text-button"
                      phx-click="retry_example"
                      phx-value-id={page.id}
                    >
                      Réessayer l’analyse
                    </button>
                  </div>
                  <button
                    id={"delete-example-#{page.id}"}
                    class="icon-button"
                    phx-click="delete_page"
                    phx-value-id={page.id}
                    data-confirm="Supprimer ce contrôle d’exemple ?"
                    aria-label={"Supprimer #{page.filename}"}
                  >
                    <.icon name="close" />
                  </button>
                </div>
              </article>
            </div>
            <.form
              for={@form}
              id="upload-examples"
              phx-change="validate"
              phx-submit="upload_examples"
            >
              <.upload_field
                upload={@uploads.examples}
                name="examples"
                label="Ajouter des photos de contrôles"
              />
              <p class="muted upload-help">
                Ajoute des contrôles pour guider la forme et la répartition des questions, sans utiliser leur contenu pédagogique.
              </p>
              <div :if={@uploads.examples.entries != []} class="form-actions">
                <button
                  id="save-examples"
                  class="button primary"
                  disabled={Enum.any?(@uploads.examples.entries, &(!&1.done?))}
                >
                  Enregistrer les exemples
                </button>
              </div>
            </.form>
          </section>
        </div>
        <div :if={@lesson_tab == "cours"} id="lesson-course">
          <div class="section-heading">
            <h2>La leçon</h2>
            <button class="button text-button" phx-click="open_modal" phx-value-modal="pages">
              <.icon name="plus" /> Ajouter des pages
            </button>
          </div>
          <div :if={Enum.all?(@lesson.pages, &(&1.kind != "lesson"))} class="empty-state compact">
            <.icon name="paper" />
            <p>Aucune page</p>
          </div>
          <div class="pages-grid">
            <article
              :for={
                {page, index} <-
                  @lesson.pages |> Enum.filter(&(&1.kind == "lesson")) |> Enum.with_index(1)
              }
              id={"lesson-page-#{page.id}"}
              class="page-card"
            >
              <button
                type="button"
                class="page-preview"
                phx-click="edit_page"
                phx-value-id={page.id}
                aria-label={"Vérifier la page #{index}"}
              >
                <img
                  src={child_path(@profile, ~p"/pages/#{page.id}")}
                  alt={"Page #{index} de la leçon"}
                />
              </button>
              <div class="page-order-actions">
                <button
                  id={"page-previous-#{page.id}"}
                  type="button"
                  class="icon-button"
                  phx-click="move_page"
                  phx-value-id={page.id}
                  phx-value-direction="previous"
                  disabled={index == 1}
                  aria-label={"Déplacer la page #{index} avant la précédente"}
                  title="Déplacer avant"
                >
                  <.icon name="back" />
                </button>
                <button
                  id={"page-next-#{page.id}"}
                  type="button"
                  class="icon-button"
                  phx-click="move_page"
                  phx-value-id={page.id}
                  phx-value-direction="next"
                  disabled={index == Enum.count(@lesson.pages, &(&1.kind == "lesson"))}
                  aria-label={"Déplacer la page #{index} après la suivante"}
                  title="Déplacer après"
                >
                  <.icon name="arrow" />
                </button>
              </div>
              <div class="page-caption">
                <div>
                  <strong>Page {index}</strong>
                  <.processing_progress
                    :if={page.status == "pending" or page.processing_stage != nil}
                    id={"page-progress-#{page.id}"}
                    percent={page.processing_progress}
                    stage={page.processing_stage || "Lecture OCR"}
                  />
                  <span
                    :if={page.status != "pending" and page.processing_stage == nil}
                    class={if page.status == "error", do: "warning-text", else: "muted"}
                  >
                    {page_status(page)}
                  </span>
                </div>
                <button
                  class="icon-button"
                  phx-click="delete_page"
                  phx-value-id={page.id}
                  data-confirm="Supprimer cette page ?"
                  aria-label={"Supprimer la page #{index}"}
                >
                  <.icon name="close" />
                </button>
              </div>
            </article>
          </div>
        </div>
        <div :if={@lesson_tab == "ressources"} id="lesson-resources">
          <p class="muted resource-intro">
            Ajoute des documents ou des liens pour enrichir les contrôles. Les exercices des évaluations et fiches d’activité sont utilisés en priorité, avec leurs illustrations d’origine.
          </p>
          <div class="resource-imports">
            <.form
              for={@form}
              id="upload-resources"
              phx-change="validate"
              phx-submit="upload_resources"
            >
              <.upload_field
                upload={@uploads.resources}
                name="resources"
                label="Ajouter des documents"
              />
              <div class="resource-upload-footer">
                <p class="muted">PDF, JPEG, PNG ou WebP.</p>
                <button
                  id="open-resource-url"
                  type="button"
                  class="resource-url-link"
                  phx-click="open_modal"
                  phx-value-modal="resource_url"
                  aria-haspopup="dialog"
                  aria-controls="resource-url-modal"
                >
                  Importer depuis une URL
                </button>
              </div>
              <div :if={@uploads.resources.entries != []} class="form-actions">
                <button
                  id="save-resources"
                  class="button primary"
                  disabled={Enum.any?(@uploads.resources.entries, &(!&1.done?))}
                >
                  Importer les documents
                </button>
              </div>
            </.form>
          </div>
          <div :if={@lesson.resources == []} class="empty-state compact">
            <p>Aucune ressource pour cette leçon.</p>
          </div>
          <div id="resource-list" class="resource-list" phx-update="stream">
            <article
              :for={{dom_id, resource} <- @streams.resources}
              id={dom_id}
              class="panel resource-card"
            >
              <div class="section-heading">
                <div>
                  <h2 :if={
                    resource.status != "processing" and resource.processing_stage == nil and
                      resource.filename != "view"
                  }>
                    {resource.filename}
                  </h2>
                  <p
                    class={[
                      "muted",
                      (resource.status == "processing" or resource.processing_stage != nil) &&
                        "resource-import-status"
                    ]}
                    role="status"
                  >
                    <.processing_progress
                      :if={resource.status == "processing" or resource.processing_stage != nil}
                      id={"resource-progress-#{resource.id}"}
                      percent={resource.processing_progress}
                      stage={resource.processing_stage || "Préparation de l’import"}
                    />
                    <span :if={
                      resource.status != "processing" and resource.processing_stage == nil
                    }>
                      {resource_status(resource)}
                    </span>
                  </p>
                </div>
                <button
                  id={"delete-resource-#{resource.id}"}
                  class="icon-button"
                  phx-click="delete_resource"
                  phx-value-id={resource.id}
                  data-confirm="Supprimer cette ressource et ses pages importées ? Les illustrations des contrôles déjà créés sont conservées."
                  aria-label={"Supprimer #{resource.filename}"}
                >
                  <.icon name="close" />
                </button>
              </div>
              <p :if={resource.source_url} class="resource-source">
                <a href={resource.source_url} target="_blank" rel="noopener noreferrer">
                  {resource.source_url}
                </a>
              </p>
              <.link
                :if={resource.storage_key}
                href={child_path(@profile, "/ressources/#{resource.id}")}
                class="resource-original"
              >
                Télécharger le document original
              </.link>
              <p :if={resource.error} class="error" role="alert">{resource.error}</p>
              <button
                :if={resource.status == "error"}
                id={"retry-resource-#{resource.id}"}
                class="button secondary"
                phx-click="retry_resource"
                phx-value-id={resource.id}
              >
                Réessayer l’import
              </button>
              <details :if={resource_pages(@lesson, resource.id) != []} class="resource-content">
                <summary>
                  Texte reconnu · {count_label(
                    length(resource_pages(@lesson, resource.id)),
                    "page",
                    "pages"
                  )}
                </summary>
                <div
                  :for={{page, index} <- Enum.with_index(resource_pages(@lesson, resource.id), 1)}
                  class="resource-page"
                >
                  <div class="section-heading">
                    <strong>Page {index}</strong>
                    <button
                      class="button text-button"
                      phx-click="edit_page"
                      phx-value-id={page.id}
                    >
                      Vérifier le texte
                    </button>
                  </div>
                  <p class="resource-text">{page.text}</p>
                </div>
              </details>
              <details :if={resource_images(@lesson, resource.id) != []} class="resource-content">
                <summary>
                  {length(resource_images(@lesson, resource.id))} illustrations conservées
                </summary>
                <div class="pages-grid">
                  <a
                    :for={page <- resource_images(@lesson, resource.id)}
                    href={child_path(@profile, ~p"/pages/#{page.id}")}
                    target="_blank"
                    rel="noopener"
                  >
                    <img
                      src={child_path(@profile, ~p"/pages/#{page.id}")}
                      alt={page.filename}
                      loading="lazy"
                    />
                  </a>
                </div>
              </details>
            </article>
          </div>
        </div>
        <div class="page-delete-actions">
          <span
            id="delete-lesson-tooltip"
            class="popover-anchor delete-lesson-tooltip"
            tabindex={if not Study.lesson_empty?(@lesson), do: "0"}
            aria-describedby={if not Study.lesson_empty?(@lesson), do: "delete-lesson-help"}
          >
            <button
              id="delete-lesson"
              type="button"
              class="button text-button"
              phx-click="delete_lesson"
              disabled={not Study.lesson_empty?(@lesson)}
              data-confirm="Supprimer cette leçon vide ? Cette action est définitive."
            >
              <.icon name="close" /> Supprimer la leçon
            </button>
            <span
              :if={not Study.lesson_empty?(@lesson)}
              id="delete-lesson-help"
              role="tooltip"
              class="popover-content"
            >
              Seule une leçon sans cours, contrôle ni ressource peut être supprimée.
            </span>
          </span>
        </div>
      </section>

      <section :if={@live_action == :new_exam} class="setup-section">
        <div class="page-heading">
          <.page_breadcrumb
            id="new-exam-title"
            subject={@subject}
            ancestors={[
              {"Matières", child_path(@profile, ~p"/")},
              {@subject.name, child_path(@profile, ~p"/matieres/#{@subject.id}")},
              {@lesson.title, child_path(@profile, ~p"/lecons/#{@lesson.id}")}
            ]}
          >
            Nouveau contrôle
          </.page_breadcrumb>
        </div>
        <.form
          for={@form}
          id="exam-setup"
          phx-change="configure_exam"
          phx-submit="generate_exam"
          class="panel setup-panel"
        >
          <fieldset disabled={@busy}>
            <fieldset id="exam-format" class="exam-format-choice">
              <legend class="exam-field-label">Format du contrôle</legend>
              <div class="exam-format-options">
                <label for="exam-format-classic">
                  <input
                    id="exam-format-classic"
                    type="radio"
                    name="format"
                    value="classic"
                    checked={@exam_format == "classic"}
                  /> Classique
                </label>
                <label for="exam-format-flashcard">
                  <input
                    id="exam-format-flashcard"
                    type="radio"
                    name="format"
                    value="flashcard"
                    checked={@exam_format == "flashcard"}
                  /> Flashcard
                </label>
              </div>
              <p :if={@exam_format == "flashcard"} id="flashcard-help" class="muted">
                Révise toutes les pages de ta leçon avec des cartes rapides et ludiques, corrigées une par une. Les contrôles d’exemple et les ressources externes ne sont pas utilisés. Chaque carte vaut 1 point.
              </p>
            </fieldset>
            <div class="count-row">
              <label class="exam-field-label" for="question-count">Nombre de questions</label>
              <div class="stepper">
                <button
                  type="button"
                  phx-click="change_count"
                  phx-value-delta="-1"
                  disabled={@question_count <= 1}
                  aria-label="Moins de questions"
                >
                  <.icon name="minus" />
                </button>
                <output id="question-count" aria-live="polite">{@question_count}</output><button
                  type="button"
                  phx-click="change_count"
                  phx-value-delta="1"
                  disabled={@question_count >= 30}
                  aria-label="Plus de questions"
                ><.icon name="plus" /></button>
              </div>
            </div>
            <fieldset
              id="question-types"
              class="question-types"
              aria-describedby="question-types-help"
            >
              <legend class="exam-field-label">Types de questions</legend>
              <p id="question-types-help" class="muted">
                <%= if @exam_format == "flashcard" do %>
                  Seuls les types de questions de durée rapide sont disponibles en mode Flashcard.
                <% else %>
                  Les exemples guident la répartition parmi les types cochés, selon le cours et les supports disponibles.
                <% end %>
              </p>
              <p :if={@available_question_types == []} class="notice">
                Aucun type disponible. Ajoute un type dans les paramètres de cette matière.
              </p>
              <.link
                class="question-types-settings-link"
                navigate={child_path(@profile, ~p"/matieres/#{@subject.id}/parametres")}
              >
                Configurer les types de questions
              </.link>
              <input type="hidden" name="question_types[]" value="" />
              <div class="subject-checkbox-grid">
                <label
                  :for={type <- @available_question_types}
                  class="subject-checkbox"
                  for={"question-type-#{type["id"]}"}
                  title={type["description"]}
                >
                  <input
                    type="checkbox"
                    id={"question-type-#{type["id"]}"}
                    name="question_types[]"
                    value={type["id"]}
                    checked={type["id"] in @question_types}
                    disabled={@exam_format == "flashcard" and type["work_duration"] != "quick"}
                  />
                  <span>{type["label"]}</span>
                </label>
              </div>
              <p :if={@question_types == []} id="question-types-error" class="error">
                Choisis au moins un type de question.
              </p>
            </fieldset>
            <label class="exam-field-label" for="instructions">
              Consignes personnalisées (facultatif)
            </label>
            <p class="muted">
              Ces consignes sont prioritaires sur les règles par défaut : notions à réviser, contenus à ignorer, difficulté ou forme des questions.
            </p>
            <textarea
              id="instructions"
              name="instructions"
              rows="4"
              maxlength="8000"
              placeholder="Ex. : Ignorer les activités et interroger uniquement sur les connaissances du cours."
              phx-debounce="300"
            >{@instructions}</textarea>
            <div class="form-actions">
              <.link
                navigate={child_path(@profile, ~p"/lecons/#{@lesson.id}")}
                class="button secondary"
              >
                Annuler
              </.link>
              <button
                class="button primary"
                id="generate-exam"
                disabled={@busy or @question_types == []}
                aria-busy={to_string(@busy)}
              >
                Créer le contrôle <.icon name="arrow" />
              </button>
            </div>
          </fieldset>
        </.form>
      </section>

      <section :if={@live_action == :exam}>
        <div class="page-heading exam-title">
          <div>
            <.page_breadcrumb
              id="exam-title"
              subject={@subject}
              ancestors={[
                {"Matières", child_path(@profile, ~p"/")},
                {@subject.name, child_path(@profile, ~p"/matieres/#{@subject.id}")},
                {@lesson.title, child_path(@profile, ~p"/lecons/#{@lesson.id}")}
              ]}
            >
              Contrôle
              <:trailing :if={@exam.status == "completed"}>
                <div
                  class="popover-anchor score-popover"
                  tabindex="0"
                  aria-describedby="exam-score-tooltip"
                >
                  <div class={["total-score", score_class(Exams.round_score(@exam.score))]}>
                    {number(Exams.round_score(@exam.score))}<span>/20</span>
                  </div>
                  <span id="exam-score-tooltip" role="tooltip" class="popover-content">
                    {raw_score_label(@exam)}
                  </span>
                </div>
              </:trailing>
            </.page_breadcrumb>
          </div>
        </div>
        <div
          :if={@exam.status == "completed" and @exam.appreciation}
          id="exam-result-summary"
          class="exam-result-summary"
        >
          <p
            :if={@exam.appreciation}
            id="exam-appreciation"
            class={["exam-appreciation", score_class(Exams.round_score(@exam.score))]}
          >
            {@exam.appreciation}
          </p>
        </div>
        <section
          :if={@exam.status in ["generation_partial", "generating"]}
          id="generation-status"
          class="panel"
        >
          <h2>
            {count_label(length(@exam.questions), "question prête", "questions prêtes")} sur {@exam.generation_target}
          </h2>
          <p :if={@exam.status == "generating"} id="generation-stage" role="status">
            <span class="spinner" aria-hidden="true" />
            <span>{generation_stage_label(@exam.generation_stage)}</span>
          </p>
          <p :if={@exam.status == "generating"} class="muted">
            Tu peux quitter la page, la génération continue.
          </p>
          <ul
            :if={@exam.status == "generation_partial" and @exam.generation_errors != []}
            id="generation-errors"
          >
            <li :for={
              reason <- CaptainHomework.Exams.Generation.public_errors(@exam.generation_errors)
            }>
              {reason}
            </li>
          </ul>
          <button
            :if={@exam.status == "generation_partial"}
            id="resume-generation"
            class="button primary"
            phx-click="resume_generation"
            disabled={@busy}
          >
            Réessayer les questions manquantes
          </button>
        </section>
        <div
          :if={@exam.format == "classic" and @exam.status in ["in_progress", "grading"]}
          class="exam-progress"
        >
          <span>{completed_count(@exam, @answers)} / {length(@exam.questions)} réponses</span><span
            id="saved"
            phx-hook="Saved"
            data-saved={@saved}
            class="saved"
          ><.icon name="check" /> Enregistré</span>
          <progress
            max={length(@exam.questions)}
            value={completed_count(@exam, @answers)}
            aria-label="Réponses complétées"
          />
        </div>
        <p
          :if={@exam.format == "classic" and @exam.status == "grading"}
          class="notice"
          role="status"
        >
          <span class="spinner" /> Correction en cours…
        </p>
        <.form
          :if={
            @exam.status == "completed" or
              (@exam.format == "classic" and @exam.status in ["in_progress", "grading"])
          }
          for={@form}
          phx-change="save_answers"
          phx-submit="confirm_submit"
          id="exam-answers"
          phx-hook="ExamAnswers"
        >
          <fieldset disabled={@exam.status == "grading"}>
            <section
              :for={group <- CaptainHomework.Exams.SupportGroups.build(@exam.questions)}
              class={[group.shared? && "question-group"]}
              id={"question-group-#{group.support["id"]}"}
            >
              <header :if={group.shared?} class="shared-question-support">
                <h2>
                  Document commun aux questions {Enum.map_join(group.questions, ", ", fn {_,
                                                                                          index} ->
                    index
                  end)}
                </h2>
                <.question_images question={group.support} exam={@exam} profile={@profile} />
                <div :if={group.support["text"] != ""} class="reading-text" phx-no-format>{readable_text(group.support["text"])}</div>
              </header>
              <article
                :for={{q, index} <- group.questions}
                class="question"
                id={"question-#{q["id"]}"}
              >
                <div class="question-meta">
                  <span class="question-number">{index}</span><span>{type_name(q["type"])}</span><span class="points">{q["points"]} {if q["points"] == 1, do: "point", else: "points"}</span>
                </div>
                <h2>{q["prompt"]}</h2>
                <.question_images
                  :if={!group.shared?}
                  question={q}
                  exam={@exam}
                  profile={@profile}
                />
                <div :if={!group.shared? and q["text"] != ""} class="reading-text" phx-no-format>{readable_text(q["text"])}</div>
                <.diagram :if={q["type"] == "diagram"} question={q} />
                <div :if={@exam.status != "completed"}>
                  <div :if={q["type"] == "mcq"} class="options">
                    <label
                      :for={{option, i} <- Enum.with_index(q["options"])}
                      class={["option", @answers[q["id"]] == option && "selected"]}
                    >
                      <input
                        type="radio"
                        name={"answers[#{q["id"]}]"}
                        value={option}
                        checked={@answers[q["id"]] == option}
                      /><span class="option-letter">{<<65 + i>>}</span><span>{option}</span>
                    </label>
                  </div>
                  <div :if={q["type"] in ["cloze", "diagram"]} class="slot-inputs">
                    <div :for={slot <- q["slots"]}>
                      <label for={"answer-#{q["id"]}-#{slot}"}>{slot}</label>
                      <input
                        id={"answer-#{q["id"]}-#{slot}"}
                        name={"answers[#{q["id"]}][#{slot}]"}
                        value={slots_value(@answers, q["id"], slot)}
                        phx-debounce="500"
                        maxlength="2000"
                        autocomplete="off"
                      />
                    </div>
                  </div>
                  <div :if={q["type"] == "definition"}>
                    <label class="sr-only" for={"answer-#{q["id"]}"}>Ta réponse</label>
                    <input
                      id={"answer-#{q["id"]}"}
                      name={"answers[#{q["id"]}]"}
                      value={@answers[q["id"]] || ""}
                      phx-debounce="500"
                      maxlength="12000"
                      autocomplete="off"
                    />
                  </div>
                  <div :if={q["type"] in ["long", "reading"]}>
                    <label class="sr-only" for={"answer-#{q["id"]}"}>Ta réponse</label><textarea
                      id={"answer-#{q["id"]}"}
                      name={"answers[#{q["id"]}]"}
                      rows="5"
                      phx-debounce="500"
                      maxlength="12000"
                    >{@answers[q["id"]] || ""}</textarea>
                    <button
                      type="button"
                      class="button text-button photo-answer"
                      phx-click="open_ocr"
                      phx-value-id={q["id"]}
                    >
                      <.icon name="camera" /> Répondre avec une photo
                    </button>
                  </div>
                </div>
                <div :if={@exam.status == "completed"} class="graded-answer">
                  <div class="student-answer" id={"student-answer-#{q["id"]}"}>
                    <div
                      :for={
                        row <-
                          CaptainHomework.Exams.Language.rows(
                            @exam.answers[q["id"]],
                            @exam.corrections[q["id"]]["language_errors"] || []
                          )
                      }
                      class="answer-language-row"
                      phx-no-format
                    ><span :if={row.field != ""}>{row.field <> " : "}</span><%= for segment <- row.segments do %><%= if segment.error do %><button type="button" class="language-error" phx-click="explain_language" phx-value-question={q["id"]} phx-value-index={segment.index} aria-label={"Expliquer la correction : #{segment.text} → #{segment.error["replacement"]}"}><del>{segment.text}</del><span class="language-replacement">{" " <> segment.error["replacement"]}</span></button><% else %>{segment.text}<% end %><% end %></div>
                  </div>
                  <div class={[
                    "correction",
                    @exam.corrections[q["id"]]["points"] == q["points"] && "correction-correct"
                  ]}>
                    <div class="correction-heading">
                      <strong>Correction</strong><strong>{number(@exam.corrections[q["id"]]["points"])} / {q["points"]}</strong>
                    </div>
                    <p>{@exam.corrections[q["id"]]["feedback"]}</p>
                    <div class="expected">
                      <div class="correction-heading">
                        <strong>Réponse attendue</strong>
                      </div>
                      <p class="expected-answer">{@exam.corrections[q["id"]]["expected"]}</p>
                    </div>
                    <div class="correction-sources" id={"question-sources-#{q["id"]}"}>
                      <strong>Sources</strong>
                      <ul :if={Map.get(@exam_sources, q["id"], []) != []}>
                        <li :for={source <- Map.get(@exam_sources, q["id"], [])}>
                          <.link
                            href={child_path(@profile, ~p"/pages/#{source.page_id}")}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {source.label}
                            <span class="sr-only">
                              (ouvre la page d’origine dans un nouvel onglet)
                            </span>
                          </.link>
                          <span :if={source.page_number} class="source-page-number">
                            (page {source.page_number})
                          </span>
                        </li>
                      </ul>
                      <p :if={Map.get(@exam_sources, q["id"], []) == []}>
                        Source non enregistrée ou indisponible pour cette question.
                      </p>
                    </div>
                  </div>
                </div>
              </article>
            </section>
          </fieldset>
        </.form>
        <div class="exam-bottom-actions">
          <div class="exam-footer" id="exam-footer">
            <span
              :if={@exam.status != "generating"}
              id="generation-duration"
              class="generation-duration"
            >
              <%= if is_integer(@exam.generation_duration_ms) do %>
                Généré en {generation_duration(@exam.generation_duration_ms)}
              <% else %>
                Temps de génération non enregistré
              <% end %>
            </span>
            <span
              :if={@exam.status != "generating" and Study.exam_deletable?(@exam)}
              aria-hidden="true"
            >
              -
            </span>
            <button
              :if={@exam.status != "generating" and Study.exam_deletable?(@exam)}
              id="delete-exam"
              type="button"
              class="button text-button"
              phx-click="delete_exam"
              data-confirm="Supprimer ce contrôle non rendu ? Cette action est définitive."
            >
              Supprimer
            </button>
          </div>
          <button
            :if={@exam.status == "in_progress" and @exam.format == "classic"}
            type="submit"
            form="exam-answers"
            class="button primary"
            id="finish-exam"
          >
            Rendre ma copie <.icon name="check" />
          </button>
        </div>
      </section>
    </div>

    <.modal
      :if={@modal == "language_error" && @language_error}
      id="language-error-modal"
      title="Comprendre la correction"
    >
      <p class="language-error-example">
        <del>{@language_error["original"]}</del> {@language_error["replacement"]}
      </p>
      <p id="language-error-explanation">{@language_error["explanation"]}</p>
    </.modal>

    <.modal :if={@modal == "resource_url"} id="resource-url-modal" title="Importer depuis une URL">
      <.form
        for={@resource_form}
        id="resource-url-form"
        phx-change="validate_resource_url"
        phx-submit="add_resource_url"
      >
        <label for="resource-url">Adresse du document</label>
        <input
          id="resource-url"
          name={@resource_form[:url].name}
          type="url"
          value={@resource_form[:url].value}
          placeholder="https://drive.google.com/file/d/…/view"
          aria-describedby={
            if @error, do: "resource-url-help resource-url-error", else: "resource-url-help"
          }
          aria-invalid={if @error, do: "true", else: nil}
          required
          maxlength="4000"
        />
        <p id="resource-url-help" class="muted upload-help">
          Page web, PDF, image ou lien Google Drive accessible publiquement.
        </p>
        <p :if={@error} id="resource-url-error" class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button
            id="cancel-resource-url"
            type="button"
            class="button secondary"
            phx-click="close_modal"
          >
            Annuler
          </button>
          <button id="add-resource-url" class="button primary" phx-disable-with="Ajout…">
            Importer
          </button>
        </div>
      </.form>
    </.modal>
    <.modal :if={@modal == "lesson"} title="Nouvelle leçon">
      <.form for={@form} phx-change="validate" phx-submit="create_lesson" id="lesson-form">
        <label for="lesson-title">Nom de la leçon</label>
        <input id="lesson-title" name="title" required maxlength="120" />
        <p class="muted date-line">{date(Study.today())}</p>
        <label>Pages de la leçon</label>
        <.upload_field upload={@uploads.pages} name="pages" label="Ajouter des pages" />
        <p :if={@error} class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button class="button primary" phx-disable-with="Enregistrement…">
            Créer la leçon
          </button>
        </div>
      </.form>
    </.modal>
    <.modal :if={@modal == "pages"} title="Ajouter des pages">
      <.form for={@form} phx-change="validate" phx-submit="upload_pages" id="upload-pages">
        <.upload_field upload={@uploads.pages} name="pages" label="Choisir des photos" />
        <p :if={@error} class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button
            class="button primary"
            disabled={@uploads.pages.entries == []}
            phx-disable-with="Enregistrement…"
          >
            Ajouter
          </button>
        </div>
      </.form>
    </.modal>
    <.modal :if={@modal == "edit_page"} id="page-modal" title="Vérifier la page">
      <div class="page-editor">
        <a
          href={child_path(@profile, ~p"/pages/#{@edit_page.id}")}
          target="_blank"
          rel="noreferrer"
        >
          <img
            :if={String.starts_with?(@edit_page.content_type, "image/")}
            src={child_path(@profile, ~p"/pages/#{@edit_page.id}")}
            alt="Page originale"
          />
          <span :if={!String.starts_with?(@edit_page.content_type, "image/")}>
            Voir le texte original
          </span>
        </a>
        <.form for={@form} phx-change="validate_page" phx-submit="save_page" id="page-text-form">
          <label for="page-text">Texte reconnu</label><textarea
            id="page-text"
            name="text"
            rows="14"
            maxlength="60000"
          >{@page_text}</textarea>
          <.processing_progress
            :if={@edit_page.status == "pending" or @edit_page.processing_stage != nil}
            id="editor-processing-progress"
            percent={@edit_page.processing_progress}
            stage={@edit_page.processing_stage || "Lecture OCR"}
          />
          <p :if={@edit_page.error} class="error">{@edit_page.error}</p>
          <button
            :if={String.starts_with?(@edit_page.content_type, "image/")}
            type="button"
            class="button text-button"
            phx-click="transcribe_page"
            phx-value-id={@edit_page.id}
            disabled={@edit_page.status == "pending" or @edit_page.processing_stage != nil}
          >
            {if @edit_page.status == "pending", do: "Lecture en cours…", else: "Relire la photo"}
          </button>
          <div class="form-actions"><button class="button primary">Enregistrer</button></div>
        </.form>
      </div>
    </.modal>
    <.modal :if={@modal == "answer_photo"} title="Ta réponse en photo">
      <.form
        :if={!@ocr_text}
        for={@form}
        phx-change="validate"
        phx-submit="transcribe_answer"
        id="answer-photo-form"
      >
        <.upload_field
          upload={@uploads.answer_photo}
          name="answer_photo"
          label="Choisir une photo"
        />
        <p :if={@error} class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button class="button primary" disabled={@busy || @uploads.answer_photo.entries == []}>
            Lire la photo
          </button>
        </div>
      </.form>
      <.form :if={@ocr_text} for={@form} phx-submit="use_transcription" id="transcription-form">
        <label for="transcription">Vérifie ta réponse</label><textarea
          name="text"
          id="transcription"
          rows="9"
        >{@ocr_text}</textarea>
        <div class="form-actions">
          <button class="button primary">Utiliser cette réponse</button>
        </div>
      </.form>
    </.modal>
    <div
      :if={@confirming}
      class="modal-shade"
      role="dialog"
      aria-modal="true"
      aria-labelledby="submit-title"
      id="submit-confirm"
      phx-hook="Dialog"
    >
      <.focus_wrap id="submit-focus" class="modal-panel">
        <h2 id="submit-title">Rendre ta copie ?</h2>
        <p>{completed_count(@exam, @answers)} réponses sur {length(@exam.questions)}.</p>
        <p>Tu ne pourras plus modifier tes réponses après la correction.</p>
        <div class="form-actions">
          <button class="button secondary" phx-click="cancel_submit">Continuer</button><button
            class="button primary"
            phx-click="submit_exam"
            id="confirm-finish"
          >Rendre ma copie</button>
        </div>
      </.focus_wrap>
    </div>
    <div :if={@busy} class="busy-overlay" role="status" aria-live="polite">
      <div>
        <span class="spinner" />
        <p>{@busy_text}</p>
      </div>
    </div>
  </main>
</Layouts.app>
