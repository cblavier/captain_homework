<Layouts.app
  flash={@flash}
  child_theme={if @profile, do: @profile.theme, else: "blue"}
  immersive={@live_action == :exam and flashcard_active?(@exam)}
>
  <main
    :if={@live_action == :exam and flashcard_active?(@exam)}
    id="flashcard-player"
    phx-remove={
      @exam.card_index + 1 == length(@exam.questions) &&
        JS.hide(
          to: "#flashcard-session",
          transition:
            {"flashcard-finish-transition", "flashcard-finish-start", "flashcard-finish-end"},
          time: 500
        )
    }
  >
    <.flashcard
      profile={@profile}
      exam={@exam}
      answers={@answers}
      subject={Study.subject!(@lesson.subject).name}
      error={@error}
      close_path={if !@shared, do: child_path(@profile, ~p"/lecons/#{@lesson.id}")}
    >
      <:footer :if={!@shared}>
        <div class="exam-footer flashcard-share-footer">
          <button
            :if={@exam.generation_history != []}
            id="generation-duration"
            type="button"
            class="button text-button generation-duration"
            phx-click="open_generation_history"
            aria-haspopup="dialog"
          >
            <%= if is_integer(@exam.generation_duration_ms) do %>
              Généré en {generation_duration(@exam.generation_duration_ms)}
            <% else %>
              Temps de génération non enregistré
            <% end %>
          </button>
          <button id="share-exam" type="button" class="button text-button" phx-click="open_share">
            Partager
          </button>
        </div>
      </:footer>
    </.flashcard>
  </main>
  <main
    :if={@live_action != :exam or not flashcard_active?(@exam)}
    id="homework-content"
    class={[
      "app",
      @shared && "shared-exam",
      @live_action == :exam && @exam.format == "flashcard" && @exam.status == "completed" &&
        "flashcard-results-enter"
    ]}
  >
    <.profile_header
      :if={!@shared}
      profile={@profile}
      profiles={@profiles}
      form={@form}
      settings_active={@live_action == :settings}
    />
    <p :if={@error && !@modal} class="notice error" role="alert">{@error}</p>

    <section
      :if={!@profile && @live_action != :settings}
      id="no-profiles"
      class="onboarding panel"
    >
      <div class="icon-tile purple"><.icon name="book" /></div>
      <.page_title id="no-profiles-title">Aucun espace disponible</.page_title>
      <p>Les espaces de la famille n’ont pas encore été configurés.</p>
    </section>

    <section :if={@live_action == :settings} id="settings-page" class="settings-page">
      <div class="page-heading">
        <.page_breadcrumb
          id="settings-title"
          ancestors={[{:home, child_path(@profile, ~p"/")}]}
        >
          Paramètres
        </.page_breadcrumb>
      </div>
      <div id="theme-settings" class="theme-settings" phx-hook="ThemeSettings" phx-update="ignore">
        <section class="settings-card">
          <fieldset>
            <legend>Thème</legend>
            <div class="settings-choices">
              <label
                :for={
                  {value, label} <- [{"light", "Jour"}, {"dark", "Nuit"}, {"system", "Système"}]
                }
                for={"theme-#{value}"}
              >
                <input
                  id={"theme-#{value}"}
                  type="radio"
                  name="theme"
                  value={value}
                  checked={value == "system"}
                />
                <span>{label}</span>
              </label>
            </div>
          </fieldset>
        </section>
        <section class="settings-card">
          <fieldset>
            <legend>Niveau de zoom</legend>
            <div class="settings-choices">
              <label
                :for={
                  {value, label} <- [
                    {"small", "Plus petit"},
                    {"normal", "Normal"},
                    {"large", "Plus grand"}
                  ]
                }
                for={"zoom-#{value}"}
              >
                <input
                  id={"zoom-#{value}"}
                  type="radio"
                  name="zoom"
                  value={value}
                  checked={value == "normal"}
                />
                <span>{label}</span>
              </label>
            </div>
          </fieldset>
        </section>
        <p class="muted">Ces réglages sont conservés sur cet appareil.</p>
      </div>
    </section>

    <section
      :if={@live_action == :subjects_settings}
      id="subjects-settings-page"
      class="settings-page"
    >
      <div class="page-heading">
        <.page_breadcrumb
          id="subjects-settings-title"
          ancestors={[{:home, child_path(@profile, ~p"/")}]}
        >
          Paramètres
        </.page_breadcrumb>
      </div>
      <section :if={@profile} id="student-subjects-card" class="settings-card">
        <h3>Matières de {@profile.name}</h3>
        <p class="muted">Choisis les matières proposées à cet élève.</p>
        <.link
          id="manage-student-subjects"
          class="button primary"
          navigate={child_path(@profile, ~p"/parametres/matieres")}
        >
          Gérer les matières
        </.link>
      </section>
      <section :if={@profile} id="question-types-card" class="settings-card">
        <h3>Types de questions</h3>
        <p class="muted">Catalogue commun à toutes les matières et à tous les profils.</p>
        <.link
          id="manage-question-types"
          class="button primary"
          navigate={child_path(@profile, ~p"/parametres/types")}
        >
          Gérer les types de questions
        </.link>
      </section>
    </section>

    <section :if={@live_action == :subject_preferences} id="subject-preferences-page">
      <div class="page-heading">
        <.page_breadcrumb
          id="subject-preferences-title"
          ancestors={[
            {:home, child_path(@profile, ~p"/")},
            {"Paramètres", child_path(@profile, ~p"/matieres/parametres")}
          ]}
        >
          Matières de {@profile.name}
        </.page_breadcrumb>
      </div>
      <.form
        :if={@profile}
        for={@subjects_form}
        id="subjects-settings-form"
        phx-submit="save_subjects"
        class="panel subjects-settings"
      >
        <fieldset aria-describedby="subjects-settings-help">
          <legend>Matières de {@profile.name}</legend>
          <p id="subjects-settings-help" class="muted">
            Choisis les matières à afficher. Les leçons et les contrôles des matières décochées sont conservés.
          </p>
          <input type="hidden" name="subjects[enabled_ids][]" value="" />
          <div class="subject-checkbox-grid">
            <label
              :for={subject <- Study.subjects()}
              for={"enable-subject-#{subject.id}"}
              class="subject-checkbox"
            >
              <input
                type="checkbox"
                id={"enable-subject-#{subject.id}"}
                name="subjects[enabled_ids][]"
                value={subject.id}
                checked={subject.id in @subjects_form[:enabled_ids].value}
              />
              <span>{subject.name}</span>
            </label>
          </div>
        </fieldset>
        <div class="form-actions">
          <button id="save-subjects" class="button primary" phx-disable-with="Enregistrement…">
            Enregistrer les matières
          </button>
        </div>
      </.form>
    </section>

    <div :if={@profile}>
      <section :if={@live_action == :home}>
        <div class="page-heading subjects-page-heading">
          <.page_breadcrumb id="subjects-title" ancestors={[]} title_icon="home">
            Accueil
          </.page_breadcrumb>
          <.link
            :if={CaptainHomework.Accounts.parent?(@account)}
            id="subjects-settings-button"
            class="button secondary settings-gear-button"
            navigate={child_path(@profile, ~p"/matieres/parametres")}
            aria-label="Paramètres"
          >
            <.icon name="hero-cog-6-tooth" />
          </.link>
        </div>
        <div :if={@subjects == []} id="no-enabled-subjects" class="empty-state">
          <p>Aucune matière activée.</p>
          <.link
            navigate={child_path(@profile, ~p"/matieres/parametres")}
            class="button secondary"
          >
            Choisir les matières
          </.link>
        </div>
        <div class="subject-grid">
          <.link
            :for={s <- @subjects}
            navigate={child_path(@profile, ~p"/matieres/#{s.id}")}
            class={["subject-card", s.color]}
            id={"subject-#{s.id}"}
          >
            <div class="icon-tile"><.icon name={s.icon} /></div>
            <div class="subject-copy">
              <h2>{s.name}</h2>
              <span>
                {Map.get(@counts, s.id, 0)} {if Map.get(@counts, s.id, 0) == 1,
                  do: "leçon",
                  else: "leçons"} · {Map.get(@exam_counts, s.id, 0)} {if Map.get(
                                                                           @exam_counts,
                                                                           s.id,
                                                                           0
                                                                         ) == 1,
                                                                         do: "contrôle",
                                                                         else: "contrôles"}
              </span>
            </div>
            <.icon name="arrow" class="card-arrow" />
          </.link>
        </div>
      </section>

      <section :if={@live_action == :subject}>
        <div class="page-heading">
          <.page_breadcrumb
            id="subject-title"
            subject={@subject}
            ancestors={[{:home, child_path(@profile, ~p"/")}]}
          >
            {@subject.name}
          </.page_breadcrumb>
        </div>
        <div :if={@lessons_empty?} class="empty-state">
          <.icon name="book" />
          <p>Aucune leçon</p>
        </div>
        <div class="lesson-list" id="lessons" phx-update="stream">
          <.link
            :for={{dom_id, lesson} <- @streams.lessons}
            id={dom_id}
            navigate={child_path(@profile, ~p"/lecons/#{lesson.id}")}
            class="lesson-row"
          >
            <div class="document-icon"><.icon name="paper" /></div>
            <div class="row-copy">
              <h2>{lesson.title}</h2>
              <p>
                {date(lesson.date)}
                <span>·</span> {count_label(
                  Enum.count(lesson.pages, &(&1.kind == "lesson")),
                  "page",
                  "pages"
                )}
                <span>·</span> {count_label(
                  Enum.count(lesson.exams, &(&1.status == "completed")),
                  "contrôle",
                  "contrôles"
                )}
              </p>
            </div>
            <.icon name="arrow" />
          </.link>
        </div>
        <div class="form-actions">
          <button
            class="button primary"
            phx-click="open_modal"
            phx-value-modal="lesson"
            id="new-lesson"
          >
            <.icon name="plus" /> Nouvelle leçon
          </button>
        </div>
      </section>

      <section :if={@live_action == :lesson}>
        <div class="page-heading">
          <.page_breadcrumb
            id="lesson-title"
            subject={@subject}
            ancestors={[
              {:home, child_path(@profile, ~p"/")},
              {Study.subject_short_name(@subject),
               child_path(@profile, ~p"/matieres/#{@subject.id}")}
            ]}
          >
            {@lesson.title}
          </.page_breadcrumb>
        </div>
        <nav id="lesson-navigation" class="lesson-navigation" aria-label="Sections de la leçon">
          <.link
            :for={
              {tab, label, icon, count} <- [
                {"controles", "Contrôles", "paper", length(@lesson.exams)},
                {"cours", "Cours", "book", Enum.count(@lesson.pages, &(&1.kind == "lesson"))},
                {"ressources", "Ressources", "book", length(@lesson.resources)}
              ]
            }
            id={"lesson-tab-#{tab}"}
            patch={child_path(@profile, ~p"/lecons/#{@lesson.id}") <> "?onglet=#{tab}"}
            class="navigation-tab"
            aria-current={if @lesson_tab == tab, do: "page"}
          >
            <.icon name={icon} /> {label}
            <span id={"lesson-count-#{tab}"} class="navigation-count">{count}</span>
          </.link>
        </nav>
        <div :if={@lesson_tab == "controles"} id="lesson-controls">
          <div class="section-heading">
            <div>
              <h2>Les contrôles</h2>
              <span class="muted">
                {count_label(
                  Enum.count(@lesson.exams, &(&1.status == "completed")),
                  "terminé",
                  "terminés"
                )}
              </span>
            </div>
            <.link
              navigate={child_path(@profile, ~p"/lecons/#{@lesson.id}/controle")}
              class="button primary"
              id="new-exam"
            >
              <.icon name="plus" /> Nouveau contrôle
            </.link>
          </div>
          <div :if={@lesson.exams == []} class="empty-state compact">
            <p>Aucun contrôle</p>
          </div>
          <div class="exam-history">
            <.link
              :for={{exam, index} <- Enum.with_index(@lesson.exams)}
              navigate={child_path(@profile, ~p"/controles/#{exam.id}")}
              class="lesson-row"
            >
              <div class="document-icon"><.icon name="paper" /></div>
              <div class="row-copy">
                <div class="exam-history-title">
                  <h3>Contrôle {length(@lesson.exams) - index}</h3>
                  <span
                    id={"exam-format-#{exam.id}"}
                    class={["exam-format-badge", exam.format == "flashcard" && "flashcard-badge"]}
                  >
                    {if exam.format == "flashcard", do: "Flashcard", else: "Classique"}
                  </span>
                </div>
                <p>
                  {date(exam.submitted_at || exam.inserted_at)}
                  <span>·</span> {length(exam.questions)} questions
                </p>
              </div>
              <span
                :if={exam.status == "completed"}
                class={["score-badge", score_class(Exams.round_score(exam.score))]}
              >
                {number(Exams.round_score(exam.score))}<small>/20</small>
              </span>
              <span :if={exam.status != "completed"} class="status-badge">
                {case exam.status do
                  "grading" -> "Correction…"
                  "generating" -> "Préparation…"
                  "generation_partial" -> "À compléter"
                  _ -> "Reprendre"
                end}
              </span>
              <.icon name="arrow" />
            </.link>
          </div>
          <section id="lesson-examples">
            <div class="section-heading history-heading">
              <h2>Contrôles d’exemple</h2>
            </div>
            <div class="pages-grid">
              <article
                :for={
                  {page, index} <-
                    @lesson.pages |> Enum.filter(&(&1.kind == "example")) |> Enum.with_index(1)
                }
                id={"example-#{page.id}"}
                class="page-card"
              >
                <div class="page-thumbnail">
                  <button
                    id={"open-example-#{page.id}"}
                    type="button"
                    phx-click="preview_page"
                    phx-value-id={page.id}
                    aria-haspopup="dialog"
                    class="page-preview"
                  >
                    <img src={child_path(@profile, ~p"/pages/#{page.id}")} alt={page.filename} />
                  </button>
                  <.page_order_actions
                    prefix="example"
                    page_id={page.id}
                    index={index}
                    count={Enum.count(@lesson.pages, &(&1.kind == "example"))}
                    label={"la page d’exemple #{index}"}
                  />
                </div>
                <div class="page-caption">
                  <div>
                    <strong title={page.filename}>Page {index}</strong>
                    <.processing_progress
                      :if={page.processing_stage != nil}
                      id={"example-progress-#{page.id}"}
                      percent={page.processing_progress}
                      stage={page.processing_stage}
                    />
                    <span
                      :if={page.style_profile != nil and page.processing_stage == nil}
                      class="muted"
                    >
                      Prêt
                    </span>
                    <p :if={page.error != nil and page.processing_stage == nil} class="error">
                      {page.error}
                    </p>
                    <button
                      :if={page.error != nil and page.processing_stage == nil}
                      id={"retry-example-#{page.id}"}
                      type="button"
                      class="button text-button"
                      phx-click="retry_example"
                      phx-value-id={page.id}
                    >
                      Réessayer l’analyse
                    </button>
                  </div>
                  <button
                    id={"delete-example-#{page.id}"}
                    class="icon-button"
                    phx-click="delete_page"
                    phx-value-id={page.id}
                    data-confirm="Supprimer ce contrôle d’exemple ?"
                    aria-label={"Supprimer #{page.filename}"}
                  >
                    <.icon name="close" />
                  </button>
                </div>
              </article>
            </div>
            <.form
              for={@form}
              id="upload-examples"
              phx-change="validate"
              phx-submit="upload_examples"
            >
              <.upload_field
                upload={@uploads.examples}
                name="examples"
                label="Ajouter des photos de contrôles"
              />
              <p class="muted upload-help">
                Ajoute des contrôles pour guider la forme et la répartition des questions, sans utiliser leur contenu pédagogique.
              </p>
              <div :if={@uploads.examples.entries != []} class="form-actions">
                <button
                  id="save-examples"
                  class="button primary"
                  disabled={Enum.any?(@uploads.examples.entries, &(!&1.done?))}
                >
                  Enregistrer les exemples
                </button>
              </div>
            </.form>
          </section>
        </div>
        <div :if={@lesson_tab == "cours"} id="lesson-course">
          <div :if={Enum.all?(@lesson.pages, &(&1.kind != "lesson"))} class="empty-state compact">
            <.icon name="paper" />
            <p>Aucune page</p>
          </div>
          <div class="pages-grid">
            <article
              :for={
                {page, index} <-
                  @lesson.pages |> Enum.filter(&(&1.kind == "lesson")) |> Enum.with_index(1)
              }
              id={"lesson-page-#{page.id}"}
              class="page-card"
            >
              <div class="page-thumbnail">
                <button
                  type="button"
                  class="page-preview"
                  phx-click="edit_page"
                  phx-value-id={page.id}
                  aria-label={"Vérifier la page #{index}"}
                >
                  <img
                    src={child_path(@profile, ~p"/pages/#{page.id}")}
                    alt={"Page #{index} de la leçon"}
                  />
                </button>
                <.page_order_actions
                  prefix="page"
                  page_id={page.id}
                  index={index}
                  count={Enum.count(@lesson.pages, &(&1.kind == "lesson"))}
                  label={"la page #{index}"}
                />
              </div>
              <div class="page-caption">
                <div>
                  <strong>Page {index}</strong>
                  <.processing_progress
                    :if={page.status == "pending" or page.processing_stage != nil}
                    id={"page-progress-#{page.id}"}
                    percent={page.processing_progress}
                    stage={page.processing_stage || "Lecture OCR"}
                  />
                  <span
                    :if={page.status != "pending" and page.processing_stage == nil}
                    class={if page.status == "error", do: "warning-text", else: "muted"}
                  >
                    {page_status(page)}
                  </span>
                </div>
                <button
                  class="icon-button"
                  phx-click="delete_page"
                  phx-value-id={page.id}
                  data-confirm="Supprimer cette page ?"
                  aria-label={"Supprimer la page #{index}"}
                >
                  <.icon name="close" />
                </button>
              </div>
            </article>
          </div>
          <.form for={@form} phx-change="validate" phx-submit="upload_pages" id="upload-pages">
            <.upload_field upload={@uploads.pages} name="pages" label="Ajouter des pages" />
            <p :if={@error} class="error" role="alert">{@error}</p>
            <div :if={@uploads.pages.entries != []} class="form-actions">
              <button id="save-pages" class="button primary" phx-disable-with="Enregistrement…">
                Enregistrer les pages
              </button>
            </div>
          </.form>
        </div>
        <div :if={@lesson_tab == "ressources"} id="lesson-resources">
          <p class="muted resource-intro">
            Ajoute des documents ou des liens pour enrichir les contrôles. Les exercices des évaluations et fiches d’activité sont utilisés en priorité, avec leurs illustrations d’origine.
          </p>
          <div :if={@lesson.resources == []} class="empty-state compact">
            <p>Aucune ressource pour cette leçon.</p>
          </div>
          <div id="resource-list" class="resource-list" phx-update="stream">
            <article
              :for={{dom_id, resource} <- @streams.resources}
              id={dom_id}
              class="panel resource-card"
            >
              <div class="section-heading">
                <div>
                  <h2 :if={resource.status != "processing" and resource.processing_stage == nil}>
                    {resource_title(resource)}
                  </h2>
                  <p
                    :if={resource.status != "ready" or resource.processing_stage != nil}
                    class={[
                      "muted",
                      (resource.status == "processing" or resource.processing_stage != nil) &&
                        "resource-import-status"
                    ]}
                    role="status"
                  >
                    <.processing_progress
                      :if={resource.status == "processing" or resource.processing_stage != nil}
                      id={"resource-progress-#{resource.id}"}
                      percent={resource.processing_progress}
                      stage={resource.processing_stage || "Préparation de l’import"}
                    />
                    <span :if={
                      resource.status != "processing" and resource.processing_stage == nil
                    }>
                      {resource_status(resource)}
                    </span>
                  </p>
                </div>
                <div class="form-actions">
                  <button
                    id={"rename-resource-#{resource.id}"}
                    type="button"
                    class="icon-button"
                    phx-click="rename_resource"
                    phx-value-id={resource.id}
                    title="Renommer"
                    aria-label={"Renommer #{resource_title(resource)}"}
                  >
                    <.icon name="pencil" />
                  </button>
                  <button
                    id={"delete-resource-#{resource.id}"}
                    class="icon-button"
                    phx-click="delete_resource"
                    phx-value-id={resource.id}
                    data-confirm="Supprimer cette ressource et ses pages importées ? Les illustrations des contrôles déjà créés sont conservées."
                    aria-label={"Supprimer #{resource_title(resource)}"}
                  >
                    <.icon name="close" />
                  </button>
                </div>
              </div>
              <p :if={resource.error} class="error" role="alert">{resource.error}</p>
              <button
                :if={resource.status == "error"}
                id={"retry-resource-#{resource.id}"}
                class="button secondary"
                phx-click="retry_resource"
                phx-value-id={resource.id}
              >
                Réessayer l’import
              </button>
              <details
                :if={resource_pages(@lesson, resource.id) != []}
                id={"resource-text-#{resource.id}"}
                class="resource-content"
                phx-mounted={JS.ignore_attributes("open")}
              >
                <summary>
                  Texte reconnu · {count_label(
                    length(resource_pages(@lesson, resource.id)),
                    "page",
                    "pages"
                  )}
                </summary>
                <div
                  :for={{page, index} <- Enum.with_index(resource_pages(@lesson, resource.id), 1)}
                  class="resource-page"
                >
                  <div class="section-heading">
                    <strong>Page {index}</strong>
                    <button
                      :if={String.starts_with?(page.content_type, "image/")}
                      id={"delete-resource-page-#{page.id}"}
                      class="button text-button danger"
                      phx-click="delete_resource_image"
                      phx-value-id={page.id}
                      disabled={resource.status != "ready" or resource.processing_stage != nil}
                      data-confirm="Supprimer cette page importée et son texte reconnu ? Les devoirs déjà créés sont conservés."
                    >
                      Supprimer la page
                    </button>
                    <button
                      class="button text-button"
                      phx-click="edit_page"
                      phx-value-id={page.id}
                    >
                      Vérifier le texte
                    </button>
                  </div>
                  <p class="resource-text">{page.text}</p>
                </div>
              </details>
              <div class="resource-card-bottom">
                <details
                  :if={resource.status == "ready" or resource_images(@lesson, resource.id) != []}
                  id={"resource-photos-#{resource.id}"}
                  class="resource-content"
                  phx-mounted={JS.ignore_attributes("open")}
                >
                  <summary>
                    {length(resource_images(@lesson, resource.id))} illustrations conservées
                  </summary>
                  <p :if={resource_images(@lesson, resource.id) == []} class="muted">
                    Aucune image conservée.
                  </p>
                  <div class="pages-grid">
                    <article
                      :for={
                        {page, index} <- Enum.with_index(resource_images(@lesson, resource.id), 1)
                      }
                      id={"resource-image-#{page.id}"}
                      class="page-card"
                    >
                      <div class="page-thumbnail">
                        <button
                          type="button"
                          id={"open-resource-image-#{page.id}"}
                          class="page-preview"
                          phx-click="open_resource_image"
                          phx-value-id={page.id}
                          aria-label={"Extraire des illustrations de l’illustration #{index}"}
                          disabled={
                            resource.status != "ready" or resource.processing_stage != nil
                          }
                        >
                          <img
                            src={child_path(@profile, ~p"/pages/#{page.id}")}
                            alt={"Illustration #{index}"}
                            loading="lazy"
                          />
                        </button>
                        <.page_order_actions
                          prefix="resource-image"
                          page_id={page.id}
                          index={index}
                          count={length(resource_images(@lesson, resource.id))}
                          label={"l’illustration #{index}"}
                          disabled={
                            resource.status != "ready" or resource.processing_stage != nil
                          }
                        />
                      </div>
                      <div class="page-caption">
                        <div>
                          <strong title={page.filename}>Illustration {index}</strong>
                          <span class="muted">
                            {if page.text != "", do: "Texte reconnu", else: "Prête"}
                          </span>
                        </div>
                        <button
                          id={"delete-resource-image-#{page.id}"}
                          class="icon-button"
                          phx-click="delete_resource_image"
                          phx-value-id={page.id}
                          disabled={
                            resource.status != "ready" or resource.processing_stage != nil
                          }
                          data-confirm="Supprimer cette image et son éventuelle copie avec texte reconnu ? Les devoirs déjà créés sont conservés."
                          aria-label={"Supprimer l’illustration #{index}"}
                        >
                          <.icon name="close" />
                        </button>
                      </div>
                    </article>
                  </div>
                  <p :if={resource.content_type == "application/pdf"} class="muted">
                    Supprimer une illustration extraite ne la retire pas de la page PDF. Pour exclure
                    une page entière, supprime-la dans « Texte reconnu ».
                  </p>
                </details>
                <div :if={resource.storage_key} class="resource-card-actions">
                  <.link
                    id={"download-resource-#{resource.id}"}
                    href={child_path(@profile, "/ressources/#{resource.id}")}
                    class="icon-button"
                    download={resource.filename}
                    aria-label="Télécharger le document original"
                    title="Télécharger le document original"
                  >
                    <.icon name="download" />
                  </.link>
                </div>
              </div>
            </article>
          </div>
          <div class="resource-imports">
            <.form
              for={@form}
              id="upload-resources"
              phx-change="validate"
              phx-submit="upload_resources"
            >
              <.upload_field
                upload={@uploads.resources}
                name="resources"
                label="Ajouter des documents"
              />
              <div class="resource-upload-footer">
                <p class="muted">PDF, JPEG, PNG ou WebP.</p>
                <button
                  id="open-resource-url"
                  type="button"
                  class="resource-url-link"
                  phx-click="open_modal"
                  phx-value-modal="resource_url"
                  aria-haspopup="dialog"
                  aria-controls="resource-url-modal"
                >
                  Importer depuis une URL
                </button>
              </div>
              <div :if={@uploads.resources.entries != []} class="form-actions">
                <button
                  id="save-resources"
                  class="button primary"
                  disabled={Enum.any?(@uploads.resources.entries, &(!&1.done?))}
                >
                  Importer les documents
                </button>
              </div>
            </.form>
          </div>
        </div>
        <div class="page-delete-actions">
          <span
            id="delete-lesson-tooltip"
            class="popover-anchor delete-lesson-tooltip"
            tabindex={if not Study.lesson_empty?(@lesson), do: "0"}
            aria-describedby={if not Study.lesson_empty?(@lesson), do: "delete-lesson-help"}
          >
            <button
              id="delete-lesson"
              type="button"
              class="button text-button"
              phx-click="delete_lesson"
              disabled={not Study.lesson_empty?(@lesson)}
              data-confirm="Supprimer cette leçon vide ? Cette action est définitive."
            >
              <.icon name="close" /> Supprimer la leçon
            </button>
            <span
              :if={not Study.lesson_empty?(@lesson)}
              id="delete-lesson-help"
              role="tooltip"
              class="popover-content"
            >
              Seule une leçon sans cours, contrôle ni ressource peut être supprimée.
            </span>
          </span>
        </div>
      </section>

      <section :if={@live_action == :new_exam} class="setup-section">
        <div class="page-heading">
          <.page_breadcrumb
            id="new-exam-title"
            subject={@subject}
            ancestors={[
              {:home, child_path(@profile, ~p"/")},
              {Study.subject_short_name(@subject),
               child_path(@profile, ~p"/matieres/#{@subject.id}")},
              {@lesson.title, child_path(@profile, ~p"/lecons/#{@lesson.id}")}
            ]}
          >
            Nouveau contrôle
          </.page_breadcrumb>
        </div>
        <.form
          for={@form}
          id="exam-setup"
          phx-change="configure_exam"
          phx-submit="generate_exam"
          class="panel setup-panel"
        >
          <fieldset disabled={@busy} class="exam-setup-fields">
            <fieldset id="exam-format" class="exam-format-choice">
              <legend class="form-field-label">Format du contrôle</legend>
              <div class="exam-format-options">
                <label for="exam-format-classic">
                  <input
                    id="exam-format-classic"
                    type="radio"
                    name="format"
                    value="classic"
                    checked={@exam_format == "classic"}
                  /> Classique
                </label>
                <label for="exam-format-flashcard">
                  <input
                    id="exam-format-flashcard"
                    type="radio"
                    name="format"
                    value="flashcard"
                    checked={@exam_format == "flashcard"}
                  /> Flashcard
                </label>
              </div>
              <p :if={@exam_format == "flashcard"} id="flashcard-help" class="muted">
                Révise ta leçon avec des cartes rapides et ludiques. Contrôles d’exemple et ressources externes ne sont pas utilisés.
              </p>
              <p :if={@exam_format == "classic"} id="classic-help" class="muted">
                Fais un contrôle comme en classe, à partir de tes leçons, et d'éventuelles ressources externes
              </p>
            </fieldset>
            <.count_stepper
              id="question-count"
              value={@question_count}
              event="change_count"
              label="Nombre de questions"
            />
            <fieldset
              id="question-types"
              class="question-types"
              aria-describedby={if @exam_format == "flashcard", do: "question-types-help"}
            >
              <legend class="form-field-label">Types de questions</legend>
              <p :if={@exam_format == "flashcard"} id="question-types-help" class="muted">
                Les types autorisés en mode Flashcard sont disponibles.
              </p>
              <p :if={@available_question_types == []} class="notice">
                Aucun type disponible. Ajoute un type dans le catalogue commun.
              </p>
              <input type="hidden" name="question_types[]" value="" />
              <section
                :for={{duration, label, types} <- question_type_groups(@available_question_types)}
                id={"question-types-#{duration}"}
                class="question-type-group"
                aria-labelledby={"question-types-#{duration}-title"}
              >
                <h3 id={"question-types-#{duration}-title"}>{label}</h3>
                <div class="subject-checkbox-grid">
                  <label
                    :for={type <- types}
                    class="subject-checkbox"
                    for={"question-type-#{type.id}"}
                    title={type.instruction}
                  >
                    <input
                      type="checkbox"
                      id={"question-type-#{type.id}"}
                      name="question_types[]"
                      value={type.id}
                      checked={type.id in @question_types}
                      disabled={
                        not CaptainHomework.QuestionDefinitions.mode_allowed?(type, @exam_format) or
                          not CaptainHomework.QuestionDefinitions.generation_supported?(type)
                      }
                    />
                    <span>
                      {type.name}<small
                        :if={not CaptainHomework.QuestionDefinitions.generation_supported?(type)}
                        class="muted"
                      > · Aperçu uniquement</small>
                    </span>
                  </label>
                </div>
              </section>
              <p :if={@question_types == []} id="question-types-error" class="error">
                Choisis au moins un type de question.
              </p>
            </fieldset>
            <div class="exam-instructions">
              <label class="form-field-label" for="instructions">
                Consignes personnalisées <span class="form-field-optional">(facultatif)</span>
              </label>
              <.input
                wrapper={false}
                type="textarea"
                id="instructions"
                aria-describedby="instructions-help"
                name="instructions"
                rows="4"
                maxlength="8000"
                placeholder="Ex. : Ignorer les activités et interroger uniquement sur les connaissances du cours."
                phx-debounce="300"
                value={@instructions}
              />
              <p id="instructions-help" class="muted">Tes consignes sont prioritaires.</p>
            </div>
            <div class="form-actions">
              <.link
                navigate={child_path(@profile, ~p"/lecons/#{@lesson.id}")}
                class="button secondary"
              >
                Annuler
              </.link>
              <button
                class="button primary"
                id="generate-exam"
                disabled={@busy or @question_types == []}
                aria-busy={to_string(@busy)}
              >
                Créer le contrôle <.icon name="arrow" />
              </button>
            </div>
          </fieldset>
        </.form>
      </section>

      <section :if={@live_action == :exam}>
        <div class="page-heading exam-title">
          <div class={@shared && "shared-exam-heading-container"}>
            <div :if={@shared} class="shared-exam-heading">
              <div class="heading-with-icon">
                <div
                  id="shared-exam-subject-icon"
                  class={["icon-tile small", @subject.color]}
                  aria-hidden="true"
                >
                  <.icon name={@subject.icon} />
                </div>
                <div>
                  <h1 id="exam-title">Contrôle de {@subject.name}</h1>
                  <p id="shared-exam-lesson" class="muted">{@lesson.title}</p>
                </div>
              </div>
              <span
                :if={@exam.status == "completed"}
                class={["total-score", score_class(@exam.score)]}
              >
                {number(Exams.round_score(@exam.score))}<span>/20</span>
              </span>
            </div>
            <.page_breadcrumb
              :if={!@shared}
              id="exam-title"
              subject={@subject}
              ancestors={[
                {:home, child_path(@profile, ~p"/")},
                {Study.subject_short_name(@subject),
                 child_path(@profile, ~p"/matieres/#{@subject.id}")},
                {@lesson.title, child_path(@profile, ~p"/lecons/#{@lesson.id}")}
              ]}
            >
              Contrôle
              <:trailing :if={@exam.status == "completed"}>
                <div
                  class="popover-anchor score-popover"
                  tabindex="0"
                  aria-describedby="exam-score-tooltip"
                >
                  <div class={["total-score", score_class(Exams.round_score(@exam.score))]}>
                    {number(Exams.round_score(@exam.score))}<span>/20</span>
                  </div>
                  <span id="exam-score-tooltip" role="tooltip" class="popover-content">
                    {raw_score_label(@exam)}
                  </span>
                </div>
              </:trailing>
            </.page_breadcrumb>
          </div>
        </div>
        <div
          :if={@exam.status == "completed" and @exam.appreciation}
          id="exam-result-summary"
          class="exam-result-summary"
        >
          <p
            :if={@exam.appreciation}
            id="exam-appreciation"
            class={["exam-appreciation", score_class(Exams.round_score(@exam.score))]}
          >
            {@exam.appreciation}
          </p>
        </div>
        <section
          :if={!@shared and @exam.status in ["generation_partial", "generating"]}
          id="generation-status"
          class="panel generation-panel"
        >
          <details
            id="generation-history"
            phx-mounted={JS.ignore_attributes("open")}
          >
            <summary class="generation-summary">
              <div class="generation-history-toggle">
                <span>
                  <%= if @exam.status in ["generation_partial", "generating"] do %>
                    {count_label(length(@exam.questions), "question prête", "questions prêtes")} sur {@exam.generation_target}
                  <% else %>
                    Historique de génération
                  <% end %>
                </span>
                <.icon name="chevron-down" />
              </div>
              <progress
                :if={@exam.status in ["generating", "generation_partial"]}
                id="generation-question-progress"
                max={@exam.generation_target}
                value={length(@exam.questions)}
                aria-label="Questions prêtes"
              />
              <p :if={@exam.status == "generating"} id="generation-stage" role="status">
                <span
                  id="generation-stage-spinner"
                  phx-update="ignore"
                  class="spinner"
                  aria-hidden="true"
                />
                <span>{generation_stage_label(@exam.generation_stage)}</span>
              </p>
              <p :if={@exam.status == "generating"} id="generation-elapsed" class="muted">
                Temps écoulé : {generation_duration(@generation_elapsed_ms)}
              </p>
              <p :if={@exam.status == "generating"} class="muted">
                Tu peux quitter la page, la génération continue.
              </p>
            </summary>
            <div class="generation-history-content">
              <.generation_questions questions={@streams.generation_questions} />
              <p :if={@exam.generation_history != []} class="generation-history-note muted">
                Les questions prêtes sont conservées. L’historique reste consultable après la génération.
              </p>
              <ul
                :if={@exam.status == "generation_partial" and @exam.generation_errors != []}
                id="generation-errors"
              >
                <li :for={
                  reason <-
                    CaptainHomework.Exams.Generation.public_errors(@exam.generation_errors)
                }>
                  {reason}
                </li>
              </ul>
              <button
                :if={@exam.status == "generation_partial"}
                id="resume-generation"
                class="button primary"
                phx-click="resume_generation"
                disabled={@busy}
              >
                Réessayer les questions manquantes
              </button>
            </div>
          </details>
        </section>
        <div
          :if={@exam.format == "classic" and @exam.status in ["in_progress", "grading"]}
          class="exam-progress"
        >
          <span>{completed_count(@exam, @answers)} / {length(@exam.questions)} réponses</span><span
            id="saved"
            phx-hook="Saved"
            data-saved={@saved}
            class="saved"
          ><.icon name="check" /> Enregistré</span>
        </div>
        <p
          :if={@exam.format == "classic" and @exam.status == "grading"}
          class="notice"
          role="status"
        >
          <span class="spinner" /> Correction en cours…
        </p>
        <.form
          :if={
            @exam.status == "completed" or
              (@exam.format == "classic" and @exam.status in ["in_progress", "grading"])
          }
          for={@form}
          phx-change="save_answers"
          phx-submit="confirm_submit"
          id="exam-answers"
          phx-hook="ExamAnswers"
        >
          <fieldset disabled={@exam.status == "grading"}>
            <section
              :for={group <- CaptainHomework.Exams.SupportGroups.build(@exam.questions)}
              class={[(group.shared? and length(group.questions) > 1) && "question-group"]}
              id={"question-group-#{group.support["id"]}"}
            >
              <header
                :if={
                  group.shared? and length(group.questions) > 1 and
                    (String.trim(group.support["text"] || "") != "" or
                       (group.support["images"] || []) != [])
                }
                class="shared-question-support"
              >
                <h2 :if={length(group.questions) > 1}>
                  Document commun aux questions {Enum.map_join(
                    group.questions,
                    ", ",
                    fn {_, index} ->
                      index
                    end
                  )}
                </h2>
                <.question_images question={group.support} exam={@exam} profile={@profile} />
                <div :if={group.support["text"] != ""} class="reading-text" phx-no-format>{readable_text(group.support["text"])}</div>
              </header>
              <article
                :for={{q, index} <- group.questions}
                class="question"
                id={"question-#{q["id"]}"}
              >
                <.question_content
                  question={q}
                  mode="classic"
                  type_label={type_name(q["type"])}
                  index={index}
                  exam={@exam}
                  profile={@profile}
                  shared_support={group.shared? and length(group.questions) > 1}
                  show_help={@exam.status == "in_progress"}
                />
                <.question_response
                  :if={@exam.status != "completed" or q["type"] == "photo"}
                  question={q}
                  mode="classic"
                  value={@answers[q["id"]]}
                  context={CaptainHomework.Symbols.context(q, @lesson.pages)}
                  disabled={@exam.status != "in_progress"}
                  completed={@exam.status == "completed"}
                  upload={
                    if q["type"] == "photo" and @exam.status == "in_progress",
                      do: @uploads[drawing_upload_name(@exam, q["id"])]
                  }
                  photo_src={
                    if q["type"] == "photo" and is_map(@exam.answers[q["id"]]),
                      do:
                        child_path(
                          @profile,
                          ~p"/controles/#{@exam.id}/images/#{@exam.answers[q["id"]]["id"]}"
                        )
                  }
                >
                  <:text_actions :if={q["type"] in ["long", "reading"]}>
                    <button
                      type="button"
                      class="button text-button photo-answer"
                      phx-click="open_ocr"
                      phx-value-id={q["id"]}
                    >
                      <.icon name="camera" /> Répondre avec une photo
                    </button>
                  </:text_actions>
                </.question_response>
                <div :if={@exam.status == "completed"} class="graded-answer">
                  <.ordering_input
                    :if={q["type"] == "ordering"}
                    id={"ordering-#{q["id"]}"}
                    question_id={q["id"]}
                    name={"answers[#{q["id"]}]"}
                    options={q["options"]}
                    value={@exam.answers[q["id"]]}
                    disabled
                  />
                  <div
                    :if={q["type"] != "photo"}
                    class="student-answer"
                    id={"student-answer-#{q["id"]}"}
                  >
                    <div class="correction-heading">
                      <strong>Réponse de {@profile.name}</strong>
                    </div>
                    <div
                      :for={
                        row <-
                          CaptainHomework.Exams.Language.rows(
                            @exam.answers[q["id"]],
                            @exam.corrections[q["id"]]["language_errors"] || []
                          )
                      }
                      class="answer-language-row"
                      phx-no-format
                    ><span :if={row.field != ""}>{row.field <> " : "}</span><%= for segment <- row.segments do %><%= if segment.error do %><button type="button" class="language-error" phx-click="explain_language" phx-value-question={q["id"]} phx-value-index={segment.index} aria-label={"Expliquer la correction : #{segment.text} → #{segment.error["replacement"]}"}><del>{segment.text}</del><span class="language-replacement">{" " <> segment.error["replacement"]}</span></button><% else %>{segment.text}<% end %><% end %></div>
                  </div>
                  <div class={[
                    "correction",
                    @exam.corrections[q["id"]]["points"] == q["points"] && "correction-correct"
                  ]}>
                    <div class="correction-heading">
                      <strong>Correction</strong><strong>{number(@exam.corrections[q["id"]]["points"])} / {q["points"]}</strong>
                    </div>
                    <p>{@exam.corrections[q["id"]]["feedback"]}</p>
                    <div class="expected">
                      <div class="correction-heading">
                        <strong>Réponse attendue</strong>
                      </div>
                      <p class="expected-answer">{@exam.corrections[q["id"]]["expected"]}</p>
                    </div>
                    <div
                      :if={!@shared}
                      class="correction-sources"
                      id={"question-sources-#{q["id"]}"}
                    >
                      <strong>Sources</strong>
                      <ul :if={Map.get(@exam_sources, q["id"], []) != []}>
                        <li :for={source <- Map.get(@exam_sources, q["id"], [])}>
                          <button
                            type="button"
                            id={"open-source-#{q["id"]}-#{source.page_id}"}
                            class="source-link"
                            phx-click="open_source"
                            phx-value-id={source.page_id}
                            aria-haspopup="dialog"
                          >
                            {source.label}
                          </button>
                          <span :if={source.page_number} class="source-page-number">
                            (page {source.page_number})
                          </span>
                        </li>
                      </ul>
                      <p :if={Map.get(@exam_sources, q["id"], []) == []}>
                        Source non enregistrée ou indisponible pour cette question.
                      </p>
                    </div>
                  </div>
                </div>
              </article>
            </section>
          </fieldset>
        </.form>
        <div class="exam-bottom-actions">
          <div :if={!@shared} class="exam-footer" id="exam-footer">
            <button
              :if={@exam.status != "generating"}
              id="generation-duration"
              type="button"
              class="button text-button generation-duration"
              phx-click="open_generation_history"
              aria-haspopup="dialog"
              disabled={@exam.generation_history == []}
            >
              <%= if is_integer(@exam.generation_duration_ms) do %>
                Généré en {generation_duration(@exam.generation_duration_ms)}
              <% else %>
                Temps de génération non enregistré
              <% end %>
            </button>
            <span
              :if={@exam.status != "generating" and Study.exam_deletable?(@exam, @account)}
              aria-hidden="true"
            >
              -
            </span>
            <button
              :if={@exam.status != "generating" and Study.exam_deletable?(@exam, @account)}
              id="delete-exam"
              type="button"
              class="button text-button"
              phx-click="delete_exam"
              data-confirm={
                if @exam.status == "completed",
                  do: "Supprimer ce contrôle et ses résultats ? Cette action est définitive.",
                  else: "Supprimer ce contrôle ? Cette action est définitive."
              }
            >
              Supprimer
            </button>
            <span :if={@exam.status == "completed"} aria-hidden="true">-</span>
            <button
              :if={@exam.status == "completed"}
              id="redo-exam"
              type="button"
              class="button text-button"
              phx-click="redo_exam"
              phx-disable-with="Création…"
            >
              Refaire
            </button>
            <span :if={@exam.status in ["in_progress", "grading", "completed"]} aria-hidden="true">
              -
            </span>
            <button
              :if={@exam.status in ["in_progress", "grading", "completed"]}
              id="share-exam"
              type="button"
              class="button text-button"
              phx-click="open_share"
              aria-haspopup="dialog"
            >
              Partager
            </button>
          </div>
          <button
            :if={@exam.status == "in_progress" and @exam.format == "classic"}
            type="submit"
            form="exam-answers"
            class="button primary"
            id="finish-exam"
            disabled={drawing_upload_pending?(@uploads)}
          >
            Rendre ma copie <.icon name="check" />
          </button>
        </div>
      </section>
    </div>

    <.modal
      :if={@modal == "language_error" && @language_error}
      id="language-error-modal"
      title="Comprendre la correction"
    >
      <p class="language-error-example">
        <del>{@language_error["original"]}</del> {@language_error["replacement"]}
      </p>
      <p id="language-error-explanation">{@language_error["explanation"]}</p>
    </.modal>

    <.modal
      :if={@modal == "rename_resource"}
      id="rename-resource-modal"
      title="Renommer la ressource"
    >
      <.form for={@rename_resource_form} id="rename-resource-form" phx-submit="save_resource_name">
        <.input
          field={@rename_resource_form[:title]}
          id="resource-title"
          label="Nom de la ressource"
          required
          maxlength="240"
        />
        <div class="form-actions">
          <button
            id="cancel-rename-resource"
            type="button"
            class="button secondary"
            phx-click="close_modal"
          >
            Annuler
          </button>
          <button id="save-resource-name" type="submit" class="button primary">
            Enregistrer
          </button>
        </div>
      </.form>
    </.modal>

    <.modal :if={@modal == "resource_url"} id="resource-url-modal" title="Importer depuis une URL">
      <.form
        for={@resource_form}
        id="resource-url-form"
        phx-change="validate_resource_url"
        phx-submit="add_resource_url"
      >
        <label for="resource-url">Adresse du document</label>
        <.input
          wrapper={false}
          id="resource-url"
          name={@resource_form[:url].name}
          type="url"
          value={@resource_form[:url].value}
          placeholder="https://drive.google.com/file/d/…/view"
          aria-describedby={
            if @error, do: "resource-url-help resource-url-error", else: "resource-url-help"
          }
          aria-invalid={if @error, do: "true", else: nil}
          required
          maxlength="4000"
        />
        <p id="resource-url-help" class="muted upload-help">
          Page web, PDF, image ou lien Google Drive accessible publiquement.
        </p>
        <p :if={@error} id="resource-url-error" class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button
            id="cancel-resource-url"
            type="button"
            class="button secondary"
            phx-click="close_modal"
          >
            Annuler
          </button>
          <button id="add-resource-url" class="button primary" phx-disable-with="Ajout…">
            Importer
          </button>
        </div>
      </.form>
    </.modal>
    <.modal :if={@modal == "lesson"} title="Nouvelle leçon">
      <.form
        for={@lesson_form}
        phx-change="validate_lesson"
        phx-submit="create_lesson"
        id="lesson-form"
      >
        <label for="lesson-title">Nom de la leçon</label>
        <.input
          wrapper={false}
          id="lesson-title"
          name={@lesson_form[:title].name}
          value={@lesson_form[:title].value}
          required
          maxlength="120"
        />
        <p class="muted date-line">{date(Study.today())}</p>
        <label>Pages de la leçon</label>
        <.upload_field upload={@uploads.pages} name="pages" label="Ajouter des pages" />
        <p :if={@error} class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button class="button primary" phx-disable-with="Enregistrement…">
            Créer la leçon
          </button>
        </div>
      </.form>
    </.modal>
    <.modal :if={@modal == "source" and @source_page} id="source-modal" title="Source">
      <div id="source-content" class="source-content">
        <img
          :if={String.starts_with?(@source_page.content_type, "image/")}
          src={child_path(@profile, ~p"/pages/#{@source_page.id}")}
          alt="Page originale"
        />
        <p :if={!String.starts_with?(@source_page.content_type, "image/")}>
          {@source_page.text}
        </p>
      </div>
    </.modal>
    <.modal
      :if={@modal == "extract_illustrations" and @extraction_source}
      id="extract-illustrations-modal"
      title="Extraire des illustrations"
    >
      <div class="page-editor illustration-editor">
        <button
          id="preview-extraction-source"
          type="button"
          class="page-preview"
          phx-click="preview_page"
          phx-value-id={@extraction_source.id}
          aria-haspopup="dialog"
        >
          <img
            id="extraction-source-image"
            src={child_path(@profile, ~p"/pages/#{@extraction_source.id}")}
            alt="Illustration originale à recadrer"
          />
        </button>
        <.form
          for={@extraction_form}
          id="illustration-extraction-form"
          phx-change="configure_extraction"
          phx-submit="extract_illustrations"
        >
          <.count_stepper
            id="illustration-count"
            value={@extraction_count}
            unbounded
            event="change_extraction_count"
            label="Nombre d'illustrations"
            disabled={@extraction_ref != nil}
          />
          <.input
            field={@extraction_form[:instructions]}
            id="extraction-instructions"
            label="Consignes pour l'extraction"
            type="textarea"
            rows="6"
            maxlength="4000"
            disabled={@extraction_ref != nil}
            placeholder="Par exemple : la page comporte 2 exercices, chaque exercice commence par son numéro en orange."
          />
          <p class="muted extraction-note">
            L’illustration originale est conservée. Tu pourras la supprimer ensuite.
          </p>
          <p :if={@extraction_error} id="extraction-error" class="error" role="alert">
            {@extraction_error}
          </p>
          <div class="form-actions">
            <button
              id="extract-illustrations"
              type="submit"
              class="button primary"
              disabled={@extraction_ref != nil}
              aria-busy={to_string(@extraction_ref != nil)}
            >
              <span :if={@extraction_ref} class="spinner" aria-hidden="true" />
              {if @extraction_ref, do: "Extraction en cours…", else: "Extraire"}
            </button>
          </div>
        </.form>
      </div>
    </.modal>
    <.modal :if={@modal == "edit_page"} id="page-modal" title="Vérifier la page">
      <div class="page-editor">
        <button
          id="preview-original-page"
          type="button"
          class="page-preview"
          phx-click="preview_page"
          phx-value-id={@edit_page.id}
          aria-haspopup="dialog"
        >
          <img
            :if={String.starts_with?(@edit_page.content_type, "image/")}
            src={child_path(@profile, ~p"/pages/#{@edit_page.id}")}
            alt="Page originale"
          />
          <span :if={!String.starts_with?(@edit_page.content_type, "image/")}>
            Voir le texte original
          </span>
        </button>
        <.form for={@form} phx-change="validate_page" phx-submit="save_page" id="page-text-form">
          <label for="page-text">Texte reconnu</label>
          <.input
            wrapper={false}
            type="textarea"
            id="page-text"
            name="text"
            rows="14"
            maxlength="60000"
            value={@page_text}
          />
          <.processing_progress
            :if={@edit_page.status == "pending" or @edit_page.processing_stage != nil}
            id="editor-processing-progress"
            percent={@edit_page.processing_progress}
            stage={@edit_page.processing_stage || "Lecture OCR"}
          />
          <p :if={@edit_page.error} class="error">{@edit_page.error}</p>
          <button
            :if={String.starts_with?(@edit_page.content_type, "image/")}
            type="button"
            class="button text-button"
            phx-click="transcribe_page"
            phx-value-id={@edit_page.id}
            disabled={@edit_page.status == "pending" or @edit_page.processing_stage != nil}
          >
            {if @edit_page.status == "pending", do: "Lecture en cours…", else: "Relire la photo"}
          </button>
          <div class="form-actions"><button class="button primary">Enregistrer</button></div>
        </.form>
      </div>
    </.modal>
    <.modal :if={@modal == "answer_photo"} title="Ta réponse en photo">
      <.form
        :if={!@ocr_text}
        for={@form}
        phx-change="validate"
        phx-submit="transcribe_answer"
        id="answer-photo-form"
      >
        <.webcam_capture id="webcam-answer-photo" upload_name="answer_photo" />
        <.upload_field
          upload={@uploads.answer_photo}
          name="answer_photo"
          label="Choisir une photo"
        />
        <p :if={@error} class="error" role="alert">{@error}</p>
        <div class="form-actions">
          <button class="button primary" disabled={@busy || @uploads.answer_photo.entries == []}>
            Lire la photo
          </button>
        </div>
      </.form>
      <.form :if={@ocr_text} for={@form} phx-submit="use_transcription" id="transcription-form">
        <label for="transcription">Vérifie ta réponse</label>
        <.input
          wrapper={false}
          type="textarea"
          name="text"
          id="transcription"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          writingsuggestions="false"
          rows="9"
          value={@ocr_text}
        />
        <div class="form-actions">
          <button class="button primary">Utiliser cette réponse</button>
        </div>
      </.form>
    </.modal>
    <div
      :if={@confirming}
      class="modal-shade"
      role="dialog"
      aria-modal="true"
      aria-labelledby="submit-title"
      id="submit-confirm"
      phx-hook="Dialog"
    >
      <.focus_wrap id="submit-focus" class="modal-panel">
        <h2 id="submit-title">Rendre ta copie ?</h2>
        <p>{completed_count(@exam, @answers)} réponses sur {length(@exam.questions)}.</p>
        <p>Tu ne pourras plus modifier tes réponses après la correction.</p>
        <div class="form-actions">
          <button class="button secondary" phx-click="cancel_submit">Continuer</button><button
            class="button primary"
            phx-click="submit_exam"
            id="confirm-finish"
          >Rendre ma copie</button>
        </div>
      </.focus_wrap>
    </div>
    <div :if={@busy} class="busy-overlay" role="status" aria-live="polite">
      <div>
        <span class="spinner" />
        <p>{@busy_text}</p>
      </div>
    </div>
  </main>
  <.modal
    :if={!@shared && @modal == "generation_history"}
    id="generation-history-modal"
    title="Historique de génération"
  >
    <.generation_questions
      id="generation-modal-questions"
      questions={@streams.generation_questions}
    />
  </.modal>
  <.modal
    :if={!@shared && @modal == "share_exam"}
    id="share-exam-modal"
    title="Partager ce contrôle"
  >
    <p>Le lien donne accès uniquement à ce contrôle.</p>
    <div class="share-options">
      <button
        id="share-correction"
        type="button"
        class={["share-option", @share_mode == "correction" && "selected"]}
        phx-click="create_share"
        phx-value-mode="correction"
        aria-pressed={to_string(@share_mode == "correction")}
        disabled={@exam.status != "completed"}
        aria-describedby="share-correction-description"
      >
        <strong>Partager la correction</strong>
        <span id="share-correction-description">
          {if @exam.status == "completed",
            do: "Les réponses, la note et la correction du devoir en cours.",
            else: "Disponible une fois ce devoir corrigé."}
        </span>
      </button>
      <button
        id="share-fill"
        type="button"
        class={["share-option", @share_mode == "fill" && "selected"]}
        phx-click="create_share"
        phx-value-mode="fill"
        aria-pressed={to_string(@share_mode == "fill")}
      >
        <strong>Partager le contrôle à remplir</strong>
        <span>
          Chaque élève remplit sa propre copie et obtient sa correction. Lien valable {CaptainHomework.ExamShares.lifetime_days()} jours.
        </span>
      </button>
    </div>
    <p :if={@error} class="notice error" role="alert">{@error}</p>
    <div :if={@share_url} id="share-link-result" class="share-link-result">
      <label for="share-url">Lien à partager</label>
      <div class="share-url-row">
        <.input id="share-url" name="share_url" value={@share_url} readonly wrapper={false} />
        <button
          id="copy-share-url"
          type="button"
          class="button primary"
          phx-hook="CopyShareLink"
          phx-update="ignore"
          data-url={@share_url}
          aria-label="Copier le lien"
        >
          <span class="share-copy-label">Copier</span>
          <span class="share-copy-check" aria-hidden="true"><.icon name="check" /></span>
        </button>
      </div>
      <p :if={@share_expires_at} class="muted">Disponible jusqu’au {date(@share_expires_at)}.</p>
      <p id="share-copy-status" role="status" aria-live="polite" phx-update="ignore"></p>
    </div>
  </.modal>
</Layouts.app>
